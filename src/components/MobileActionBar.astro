---
// MobileActionBar.astro - Linear / Vercel Minimalist Mobile Dock
---

<!-- Fixed Mobile Action Bar for 320px+ phone viewports -->
<div 
  id="mobile-action-bar" 
  class="fixed bottom-0 left-0 right-0 z-40 p-2 sm:hidden transition-all duration-300 transform translate-y-full opacity-0 pointer-events-none"
>
  <div class="mx-auto max-w-[340px] px-3 py-2 rounded-2xl bg-neutral-950/90 backdrop-blur-xl border border-neutral-800 shadow-[0_4px_25px_rgba(0,0,0,0.8)] flex items-center justify-between gap-2 pointer-events-auto">
    <!-- Status Indicator -->
    <div class="flex items-center gap-1.5 min-w-0 flex-1">
      <span id="mobile-status-dot" class="w-2 h-2 rounded-full bg-rose-500 flex-shrink-0 animate-pulse"></span>
      <span id="mobile-status-text" class="text-[11px] font-mono text-neutral-300 truncate">
        EXIF Detected
      </span>
    </div>

    <!-- Mobile Action Buttons -->
    <div class="flex items-center gap-1.5 flex-shrink-0">
      <!-- Scrub Button -->
      <button
        id="mobile-btn-clean"
        type="button"
        class="px-3 py-1.5 rounded-lg bg-white hover:bg-neutral-200 text-neutral-950 font-semibold text-xs transition-all active:scale-95 flex items-center gap-1 shadow-sm"
      >
        <span>Scrub</span>
      </button>

      <!-- Download Button -->
      <a
        id="mobile-btn-download"
        href="#"
        download="cleanphoto.jpg"
        class="hidden px-3 py-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-semibold text-xs transition-all active:scale-95 items-center gap-1 shadow-sm"
      >
        <span>Save</span>
      </a>

      <!-- Quick Scroll to Top -->
      <a
        href="#clean-engine"
        class="p-1.5 rounded-lg bg-neutral-900 text-neutral-400 hover:text-white border border-neutral-800 text-xs flex items-center justify-center"
        aria-label="Scroll to top of engine"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </a>
    </div>
  </div>
</div>

<script>
  const mobileBar = document.getElementById('mobile-action-bar');
  const mobileStatusDot = document.getElementById('mobile-status-dot');
  const mobileStatusText = document.getElementById('mobile-status-text');
  const mobileBtnClean = document.getElementById('mobile-btn-clean');
  const mobileBtnDownload = document.getElementById('mobile-btn-download') as HTMLAnchorElement;

  window.addEventListener('cleanphoto:active-change', ((e: CustomEvent) => {
    if (!mobileBar) return;
    const { hasCleaned, cleanedUrl, filename, totalInQueue } = e.detail || {};

    if (totalInQueue > 0) {
      mobileBar.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
      mobileBar.classList.add('translate-y-0', 'opacity-100');
    } else {
      mobileBar.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
      mobileBar.classList.remove('translate-y-0', 'opacity-100');
    }

    if (hasCleaned) {
      if (mobileStatusDot) mobileStatusDot.className = "w-2 h-2 rounded-full bg-emerald-400 flex-shrink-0 shadow-[0_0_8px_#10B981]";
      if (mobileStatusText) mobileStatusText.textContent = "100% Sanitized";
      if (mobileBtnClean) mobileBtnClean.classList.add('hidden');
      if (mobileBtnDownload) {
        mobileBtnDownload.classList.remove('hidden');
        mobileBtnDownload.classList.add('flex');
        mobileBtnDownload.href = cleanedUrl || '#';
        mobileBtnDownload.download = filename || 'cleaned_photo.jpg';
      }
    } else {
      if (mobileStatusDot) mobileStatusDot.className = "w-2 h-2 rounded-full bg-rose-500 flex-shrink-0 animate-pulse";
      if (mobileStatusText) mobileStatusText.textContent = "EXIF Detected";
      if (mobileBtnClean) mobileBtnClean.classList.remove('hidden');
      if (mobileBtnDownload) {
        mobileBtnDownload.classList.add('hidden');
        mobileBtnDownload.classList.remove('flex');
      }
    }
  }) as EventListener);

  if (mobileBtnClean) {
    mobileBtnClean.addEventListener('click', () => {
      const mainCleanBtn = document.getElementById('btn-clean-single');
      if (mainCleanBtn) mainCleanBtn.click();
    });
  }
</script>
