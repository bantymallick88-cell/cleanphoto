---
// MobileActionBar.astro - Red Threat Vault Edition
---

<!-- Fixed Mobile Action Bar for 320px+ phone viewports -->
<div 
  id="mobile-action-bar" 
  class="fixed bottom-0 left-0 right-0 z-40 p-2 sm:hidden transition-all duration-300 transform translate-y-full opacity-0 pointer-events-none"
>
  <div class="mx-auto max-w-[340px] px-3 py-2 rounded-2xl bg-[#0c0507]/95 backdrop-blur-xl border border-red-500/40 shadow-[0_0_25px_rgba(0,0,0,0.9)] flex items-center justify-between gap-1.5 pointer-events-auto">
    <!-- Status Indicator -->
    <div class="flex items-center gap-1.5 min-w-0 flex-1">
      <span id="mobile-status-dot" class="w-2.5 h-2.5 rounded-full bg-red-500 flex-shrink-0 animate-pulse"></span>
      <span id="mobile-status-text" class="text-[11px] font-mono font-bold text-white truncate">
        EXIF Threat Active
      </span>
    </div>

    <!-- Mobile Action Buttons (Tightened gap, zero clipping) -->
    <div class="flex items-center gap-1 flex-shrink-0">
      <!-- Quick Clean Button -->
      <button
        id="mobile-btn-clean"
        type="button"
        class="px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-500 text-white font-bold text-xs transition-all active:scale-95 flex items-center gap-1 shadow-sm"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        <span>Scrub</span>
      </button>

      <!-- Quick Download Button -->
      <a
        id="mobile-btn-download"
        href="#"
        download="cleanphoto.jpg"
        class="hidden px-3 py-1.5 rounded-lg bg-red-500 hover:bg-red-400 text-white font-bold text-xs transition-all active:scale-95 items-center gap-1 shadow-sm"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Save</span>
      </a>

      <!-- Quick Scroll to Top / Tools -->
      <a
        href="#clean-engine"
        class="p-1.5 rounded-lg bg-[#1c0a0e] text-gray-300 hover:text-white border border-red-900/50 text-xs flex items-center justify-center"
        aria-label="Scroll to top of engine"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </a>
    </div>
  </div>
</div>

<script>
  const mobileBar = document.getElementById('mobile-action-bar');
  const mobileStatusDot = document.getElementById('mobile-status-dot');
  const mobileStatusText = document.getElementById('mobile-status-text');
  const mobileBtnClean = document.getElementById('mobile-btn-clean');
  const mobileBtnDownload = document.getElementById('mobile-btn-download') as HTMLAnchorElement;

  window.addEventListener('cleanphoto:active-change', ((e: CustomEvent) => {
    if (!mobileBar) return;
    const { hasCleaned, cleanedUrl, filename, totalInQueue } = e.detail || {};

    if (totalInQueue > 0) {
      mobileBar.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
      mobileBar.classList.add('translate-y-0', 'opacity-100');
    } else {
      mobileBar.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
      mobileBar.classList.remove('translate-y-0', 'opacity-100');
    }

    if (hasCleaned) {
      if (mobileStatusDot) mobileStatusDot.className = "w-2.5 h-2.5 rounded-full bg-red-400 flex-shrink-0 shadow-[0_0_8px_#EF4444]";
      if (mobileStatusText) mobileStatusText.textContent = "100% Sanitized";
      if (mobileBtnClean) mobileBtnClean.classList.add('hidden');
      if (mobileBtnDownload) {
        mobileBtnDownload.classList.remove('hidden');
        mobileBtnDownload.classList.add('flex');
        mobileBtnDownload.href = cleanedUrl || '#';
        mobileBtnDownload.download = filename || 'cleaned_photo.jpg';
      }
    } else {
      if (mobileStatusDot) mobileStatusDot.className = "w-2.5 h-2.5 rounded-full bg-red-500 flex-shrink-0 animate-pulse";
      if (mobileStatusText) mobileStatusText.textContent = "EXIF Threat Active";
      if (mobileBtnClean) mobileBtnClean.classList.remove('hidden');
      if (mobileBtnDownload) {
        mobileBtnDownload.classList.add('hidden');
        mobileBtnDownload.classList.remove('flex');
      }
    }
  }) as EventListener);

  if (mobileBtnClean) {
    mobileBtnClean.addEventListener('click', () => {
      const mainCleanBtn = document.getElementById('btn-clean-single');
      if (mainCleanBtn) mainCleanBtn.click();
    });
  }
</script>
