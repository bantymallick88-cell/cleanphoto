---
// PrivacyStory.astro - Human Privacy Story & Viral Share Badge
---

<section class="w-full max-w-3xl mx-auto px-4 py-8">
  <div class="relative glass-panel rounded-2xl p-6 sm:p-8 border border-white/[0.08] bg-gradient-to-b from-white/[0.03] to-white/[0.01] shadow-[0_0_50px_-20px_rgba(16,185,129,0.1)] overflow-hidden">
    
    <!-- Ambient Subtle Top Glow -->
    <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-64 h-24 bg-emerald-500/10 blur-3xl rounded-full pointer-events-none"></div>

    <div class="relative z-10 space-y-4 sm:space-y-5 text-left">
      <!-- Reassuring Shield Micro Pill -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-950/40 border border-emerald-500/25 text-emerald-400 font-mono text-[11px]">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-semibold tracking-wide uppercase">Human Privacy First</span>
      </div>

      <!-- Title -->
      <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
        Why Every Photo You Share is a Hidden Risk
      </h2>

      <!-- Story Copy (Human & Reassuring Touch) -->
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        An innocent photo shared online carries your exact home GPS coordinates, camera serial, and timestamp. Stalkers and web scrapers silently trace these metadata footprints. CleanPhoto was created to give you total control—stripping every hidden tag instantly inside your browser RAM with zero server footprint.
      </p>

      <!-- Subtle, Viral Sharing Badge -->
      <div class="pt-2">
        <button
          id="btn-viral-share"
          type="button"
          class="group inline-flex items-center gap-2.5 px-4 py-2 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.1] hover:border-emerald-500/30 text-xs sm:text-sm text-slate-200 hover:text-white transition-all duration-200 cursor-pointer shadow-sm active:scale-95"
          title="Share CleanPhoto with friends"
        >
          <span class="text-base flex-shrink-0 group-hover:scale-110 transition-transform">🤝</span>
          <span id="viral-share-label" class="font-medium">
            Protect your friends' privacy too — Share CleanPhoto
          </span>
          <svg class="w-4 h-4 text-slate-400 group-hover:text-emerald-400 transition-colors ml-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
          </svg>
        </button>
      </div>

    </div>
  </div>
</section>

<script>
  const shareBtn = document.getElementById('btn-viral-share') as HTMLButtonElement | null;
  const shareLabel = document.getElementById('viral-share-label') as HTMLSpanElement | null;

  if (shareBtn && shareLabel) {
    shareBtn.addEventListener('click', async () => {
      const shareData = {
        title: 'CleanPhoto — 100% In-Browser EXIF & Privacy Stripper',
        text: "Strip hidden home GPS coordinates & camera serials from your photos before posting online.",
        url: window.location.origin || 'https://cleanphoto.fixeehub.com'
      };

      if (navigator.share) {
        try {
          await navigator.share(shareData);
          return;
        } catch (err) {
          // If user cancelled, do nothing
          if ((err as Error).name === 'AbortError') return;
        }
      }

      // Clipboard fallback
      try {
        await navigator.clipboard.writeText(shareData.url);
        const originalText = shareLabel.textContent;
        shareLabel.textContent = "✓ Link copied! Share it with your friends";
        shareBtn.classList.add('border-emerald-500/50', 'text-emerald-300');
        setTimeout(() => {
          shareLabel.textContent = originalText;
          shareBtn.classList.remove('border-emerald-500/50', 'text-emerald-300');
        }, 3000);
      } catch {
        // Fallback prompt if clipboard fails
        window.prompt("Copy this link to share CleanPhoto:", shareData.url);
      }
    });
  }
</script>
