---
// CleanEngine.astro - Responsive Fit-Screen Edition (max-w-4xl)
---

<div id="clean-engine" class="w-full max-w-4xl mx-auto px-4 py-4 scroll-mt-20">
  <!-- Top Engine Status Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
    <div class="flex items-center gap-2.5">
      <span class="inline-flex p-2 rounded-xl bg-red-950/60 border border-red-500/40 text-red-500 shadow-[0_0_12px_rgba(239,68,68,0.3)] flex-shrink-0">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </span>
      <div class="min-w-0">
        <h2 class="text-lg sm:text-xl font-extrabold text-white flex items-center gap-2">
          <span>Metadata Scrubber</span>
          <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-red-950 border border-red-500/50 text-red-400 flex-shrink-0">
            Zero-Server
          </span>
        </h2>
        <p class="text-xs text-[#9CA3AF] truncate">100% In-Browser RAM Sanitization • Zero Cloud Storage</p>
      </div>
    </div>

    <!-- Quick Demo Photo Trigger Button -->
    <div class="flex items-center gap-2 flex-shrink-0">
      <button
        id="btn-load-sample"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-red-950/60 hover:bg-red-900/60 border border-red-500/40 text-red-200 hover:text-white text-xs font-semibold transition-all shadow-sm active:scale-95"
      >
        <svg class="w-3.5 h-3.5 text-red-400 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>⚡ Test Demo Photo</span>
      </button>

      <button
        id="btn-clear-all"
        type="button"
        class="hidden items-center gap-1 px-2.5 py-1.5 rounded-xl bg-[#1c0a0e] hover:bg-red-950/60 border border-red-900/40 text-gray-400 hover:text-red-300 text-xs transition-all"
        title="Clear all images"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        <span>Reset</span>
      </button>
    </div>
  </div>

  <!-- Main Drag & Drop Zone -->
  <div 
    id="drop-zone"
    class="relative group rounded-2xl p-6 sm:p-8 text-center border-2 border-dashed border-red-500/30 hover:border-red-500 transition-all duration-300 bg-[#0c0507]/80 hover:bg-[#1c0a0e]/90 cursor-pointer shadow-[0_0_25px_rgba(239,68,68,0.1)] hover:shadow-[0_0_35px_rgba(239,68,68,0.2)] overflow-hidden"
  >
    <!-- Hidden File Input -->
    <input 
      type="file" 
      id="file-input" 
      multiple 
      accept="image/jpeg,image/png,image/webp,image/tiff" 
      class="hidden" 
    />

    <!-- Ambient Red Grid Background in Dropzone -->
    <div class="pointer-events-none absolute inset-0 rounded-2xl opacity-40 cyber-red-grid"></div>

    <div class="relative z-10 flex flex-col items-center justify-center pointer-events-none">
      <!-- Icon -->
      <div class="w-12 h-12 sm:w-14 sm:h-14 mb-3 rounded-2xl bg-[#1c0a0e] border border-red-500/40 flex items-center justify-center text-red-500 shadow-[0_0_15px_rgba(239,68,68,0.35)] group-hover:scale-105 transition-all duration-300">
        <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
      </div>

      <h3 class="text-base sm:text-lg font-bold text-white mb-1.5">
        Drag & Drop Photos Here, or <span class="text-red-400 underline decoration-red-500/50 underline-offset-4 pointer-events-auto">Browse Device</span>
      </h3>
      <p class="text-xs text-[#9CA3AF] max-w-sm mx-auto mb-3">
        Supports batch upload of <strong class="text-white">JPEG, PNG, WebP</strong>. Zero server uploads.
      </p>

      <!-- Trust Badges Under Dropzone -->
      <div class="flex flex-wrap items-center justify-center gap-2 text-[11px] text-[#9CA3AF] font-mono">
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-[#1c0a0e] border border-red-900/50 text-red-300">
          <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span> Zero Cloud Uploads
        </span>
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-[#1c0a0e] border border-red-900/50 text-gray-300">
          <span class="w-1.5 h-1.5 rounded-full bg-white"></span> Full Resolution Kept
        </span>
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-[#1c0a0e] border border-red-900/50 text-red-300">
          <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span> Batch ZIP Export
        </span>
      </div>
    </div>
  </div>

  <!-- Loading State Indicator -->
  <div id="processing-loader" class="hidden my-6 p-5 rounded-2xl crimson-glass border border-red-500/40 text-center">
    <div class="inline-flex items-center justify-center w-10 h-10 rounded-full border-2 border-red-500 border-t-transparent animate-spin mb-2"></div>
    <h4 id="loader-status-text" class="text-sm font-bold text-white">Inspecting EXIF & GPS Metadata...</h4>
    <p class="text-[11px] text-[#9CA3AF] mt-0.5 font-mono">Processing memory buffers locally in browser RAM</p>
  </div>

  <!-- Active Work Area (Queue & Inspection) -->
  <div id="workspace-container" class="hidden mt-6 space-y-4">
    
    <!-- Top Batch Toolbar & Image Selector Carousel -->
    <div class="crimson-glass rounded-2xl p-3.5 sm:p-4 border border-red-500/20">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
        <div class="flex items-center gap-2">
          <h3 class="text-sm sm:text-base font-bold text-white">Loaded Photos</h3>
          <span id="queue-count-badge" class="px-2 py-0.5 rounded-full bg-red-950 border border-red-500/50 text-red-300 text-[11px] font-mono">
            0 files
          </span>
        </div>

        <!-- Global Batch Actions -->
        <div class="flex flex-wrap items-center gap-2">
          <!-- Format Selector -->
          <div class="flex items-center gap-1.5">
            <select 
              id="select-format" 
              class="bg-[#0c0507] border border-red-500/30 rounded-lg px-2 py-1 text-xs text-red-200 focus:outline-none focus:border-red-400"
            >
              <option value="original">Preserve Format</option>
              <option value="image/jpeg">JPEG (95% Sharp)</option>
              <option value="image/webp">WebP (Optimized)</option>
              <option value="image/png">PNG (Lossless)</option>
            </select>
          </div>

          <!-- Clean All Button -->
          <button
            id="btn-clean-all"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold text-xs transition-all shadow-[0_0_12px_rgba(239,68,68,0.4)] active:scale-95"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span>Scrub All</span>
          </button>

          <!-- Download ZIP Button -->
          <button
            id="btn-download-zip"
            type="button"
            class="hidden inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-red-700 hover:bg-red-600 text-white font-bold text-xs transition-all shadow-[0_0_12px_rgba(220,38,38,0.4)] active:scale-95"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Download All (.ZIP)</span>
          </button>
        </div>
      </div>

      <!-- Thumbnail Strip -->
      <div id="thumbnail-strip" class="flex items-center gap-2.5 overflow-x-auto pb-2 scrollbar-thin">
        <!-- Rendered dynamically -->
      </div>
    </div>

    <!-- Active Selected Image Detail & Inspector Card -->
    <div id="inspector-card" class="grid grid-cols-1 md:grid-cols-12 gap-4">
      
      <!-- Left Column: Visual Preview, Threat Badge, and Cleaning Action -->
      <div class="md:col-span-5 space-y-3">
        <div class="crimson-glass rounded-2xl p-3.5 border border-red-500/20">
          <!-- Image Title & Resolution Tag -->
          <div class="flex items-center justify-between gap-2 mb-2.5">
            <span id="active-filename" class="text-xs sm:text-sm font-bold text-white truncate max-w-[180px]">
              photo.jpg
            </span>
            <span id="active-dimensions" class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[#0c0507] border border-red-900/40 text-red-200 flex-shrink-0">
              -- × --
            </span>
          </div>

          <!-- Preview Container -->
          <div class="relative rounded-xl overflow-hidden bg-[#030102] border border-red-950 flex items-center justify-center min-h-[180px] max-h-[260px]">
            <img 
              id="active-preview-img" 
              src="" 
              alt="Photo preview" 
              class="max-w-full max-h-[250px] object-contain rounded-lg transition-transform duration-300" 
            />

            <!-- Cleaned Stamp Overlay -->
            <div id="cleaned-stamp-badge" class="hidden absolute top-2.5 right-2.5 px-2.5 py-0.5 rounded-lg bg-red-950/90 border border-red-400 text-white text-[11px] font-mono font-bold flex items-center gap-1 shadow-[0_0_15px_rgba(239,68,68,0.5)]">
              <svg class="w-3 h-3 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
              <span>SANITIZED</span>
            </div>
          </div>

          <!-- Dynamic Threat Score Meter -->
          <div class="mt-3 p-2.5 rounded-xl bg-[#0c0507] border border-red-900/40">
            <div class="flex items-center justify-between gap-2 mb-1.5">
              <span class="text-[11px] font-bold uppercase tracking-wider text-red-300">
                Threat Meter
              </span>
              <span id="threat-score-number" class="text-[11px] font-mono font-extrabold text-red-400">
                Score: 85/100
              </span>
            </div>

            <!-- Threat Score Progress Bar -->
            <div class="w-full bg-[#1c0a0e] h-2 rounded-full overflow-hidden p-0.5 mb-2 border border-red-950">
              <div 
                id="threat-score-bar" 
                class="h-full rounded-full bg-gradient-to-r from-red-600 to-red-400 transition-all duration-500 shadow-[0_0_8px_#EF4444]" 
                style="width: 85%"
              ></div>
            </div>

            <!-- Dynamic Threat Badge -->
            <div 
              id="threat-badge-container" 
              class="p-2 rounded-lg text-xs font-bold border flex items-center gap-1.5 bg-red-950/80 border-red-500/60 text-red-200"
            >
              <span id="threat-badge-icon" class="text-sm flex-shrink-0">🔴</span>
              <span id="threat-badge-text" class="leading-tight text-[11px]">
                🔴 HIGH PRIVACY RISK: EXIF & GPS Location Data Detected
              </span>
            </div>
          </div>

          <!-- Action Buttons for Current Image -->
          <div class="mt-3 flex flex-col gap-1.5">
            <button
              id="btn-clean-single"
              type="button"
              class="w-full py-2 px-3 rounded-xl bg-red-600 hover:bg-red-500 text-white font-extrabold text-xs sm:text-sm transition-all shadow-[0_0_15px_rgba(239,68,68,0.4)] active:scale-[0.98] flex items-center justify-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
              <span>Strip EXIF from this Photo</span>
            </button>

            <!-- Download Single Cleaned Image -->
            <a
              id="btn-download-single"
              href="#"
              download="cleaned_photo.jpg"
              class="hidden w-full py-2 px-3 rounded-xl bg-red-500 hover:bg-red-400 text-white font-extrabold text-xs sm:text-sm transition-all shadow-[0_0_15px_rgba(239,68,68,0.5)] active:scale-[0.98] flex items-center justify-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>Download Sanitized Photo</span>
            </a>
          </div>
        </div>

        <!-- Before / After Sanitation Diff Metrics -->
        <div id="sanitation-diff-card" class="crimson-glass rounded-2xl p-3 border border-red-500/20">
          <div class="flex items-center justify-between mb-2">
            <h4 class="text-[11px] font-bold uppercase tracking-wider text-red-400 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
              Audit Report
            </h4>
            <span id="diff-status-label" class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[#0c0507] text-[#9CA3AF] border border-red-950">
              Awaiting Scrub
            </span>
          </div>

          <div class="grid grid-cols-2 gap-2 text-left">
            <div class="p-2 rounded-xl bg-red-950/40 border border-red-500/30">
              <span class="text-[10px] text-[#9CA3AF] block mb-0.5">Pre-Clean</span>
              <div id="diff-before-tags" class="text-sm font-bold text-red-400 font-mono">-- tags</div>
              <span id="diff-before-gps" class="text-[9px] text-red-300 font-mono truncate block">GPS: Scanning</span>
            </div>

            <div class="p-2 rounded-xl bg-[#1c0a0e] border border-red-500/30">
              <span class="text-[10px] text-[#9CA3AF] block mb-0.5">Post-Clean</span>
              <div id="diff-after-tags" class="text-sm font-bold text-white font-mono">0 tags</div>
              <span id="diff-after-status" class="text-[9px] text-red-300 font-mono truncate block">100% Sanitized</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Categorized Metadata Tabs -->
      <div class="md:col-span-7 space-y-3">
        <div class="crimson-glass rounded-2xl p-3.5 sm:p-4 border border-red-500/20">
          
          <!-- Category Tabs Navigation -->
          <div class="flex items-center gap-1 border-b border-red-950 pb-2 mb-3 overflow-x-auto scrollbar-none">
            <button 
              class="tab-btn active px-2.5 py-1 rounded-lg text-xs font-bold text-white bg-red-600/30 border border-red-500/50 transition-all flex items-center gap-1 flex-shrink-0" 
              data-tab="gps"
            >
              <span>📍 GPS Location</span>
              <span id="tab-gps-count" class="px-1 py-0.2 rounded-full bg-red-950 border border-red-500/60 text-red-300 text-[9px]">!</span>
            </button>
            <button 
              class="tab-btn px-2.5 py-1 rounded-lg text-xs font-semibold text-[#9CA3AF] hover:text-white hover:bg-red-950/40 transition-all flex items-center gap-1 flex-shrink-0" 
              data-tab="hardware"
            >
              <span>📷 Device</span>
            </button>
            <button 
              class="tab-btn px-2.5 py-1 rounded-lg text-xs font-semibold text-[#9CA3AF] hover:text-white hover:bg-red-950/40 transition-all flex items-center gap-1 flex-shrink-0" 
              data-tab="exposure"
            >
              <span>⚡ Exposure</span>
            </button>
            <button 
              class="tab-btn px-2.5 py-1 rounded-lg text-xs font-semibold text-[#9CA3AF] hover:text-white hover:bg-red-950/40 transition-all flex items-center gap-1 flex-shrink-0" 
              data-tab="raw"
            >
              <span>📋 All Raw</span>
            </button>
          </div>

          <!-- TAB 1: GPS Location Data -->
          <div id="tab-content-gps" class="tab-pane space-y-3">
            
            <!-- Map Risk Warning Alert Box -->
            <div id="gps-alert-box" class="p-3 rounded-xl bg-red-950/60 border border-red-500/50 text-red-200 text-xs flex items-start gap-2 shadow-sm">
              <span class="text-base">⚠️</span>
              <div>
                <strong class="font-extrabold text-white block">Physical Location Exposed!</strong>
                <p id="gps-alert-text" class="text-[11px] text-red-200/90 leading-tight">
                  This photo contains raw GPS coordinates accurate to ~3 meters. Anyone downloading this picture can pinpoint your street or apartment address.
                </p>
              </div>
            </div>

            <!-- GPS Coordinates Grid -->
            <div class="grid grid-cols-2 gap-2 text-left">
              <div class="p-2 rounded-xl bg-[#0c0507] border border-red-950">
                <span class="text-[10px] text-[#9CA3AF] block font-mono">Latitude</span>
                <span id="gps-val-lat" class="text-xs sm:text-sm font-bold text-white font-mono break-all">
                  37.7749° N
                </span>
              </div>
              <div class="p-2 rounded-xl bg-[#0c0507] border border-red-950">
                <span class="text-[10px] text-[#9CA3AF] block font-mono">Longitude</span>
                <span id="gps-val-lng" class="text-xs sm:text-sm font-bold text-white font-mono break-all">
                  122.4194° W
                </span>
              </div>
              <div class="p-2 rounded-xl bg-[#0c0507] border border-red-950 col-span-2">
                <span class="text-[10px] text-[#9CA3AF] block font-mono">DMS Format</span>
                <span id="gps-val-dms" class="text-xs font-semibold text-red-300 font-mono break-all">
                  37° 46' 29.8" N, 122° 25' 9.8" W
                </span>
              </div>
            </div>

            <!-- Map Links -->
            <div id="gps-map-links-container" class="flex flex-wrap items-center gap-2 pt-1">
              <a
                id="link-google-maps"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-red-950/60 hover:bg-red-900/60 border border-red-500/40 text-red-300 text-xs font-mono transition-all"
              >
                <span>View Google Maps</span>
              </a>

              <a
                id="link-osm"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-red-950/60 hover:bg-red-900/60 border border-red-500/40 text-gray-200 text-xs font-mono transition-all"
              >
                <span>OpenStreetMap</span>
              </a>
            </div>

            <!-- Empty GPS State -->
            <div id="gps-empty-state" class="hidden p-4 rounded-xl bg-red-950/20 border border-red-500/30 text-center">
              <span class="text-xl block mb-1">🛡️</span>
              <h5 class="text-xs font-bold text-white mb-0.5">Zero GPS Coordinates Detected</h5>
              <p class="text-[10px] text-[#9CA3AF]">This image has no embedded physical location tags.</p>
            </div>
          </div>

          <!-- TAB 2: Hardware -->
          <div id="tab-content-hardware" class="tab-pane hidden space-y-2">
            <div class="grid grid-cols-2 gap-2">
              <div class="p-2 rounded-xl bg-[#0c0507] border border-red-950">
                <span class="text-[10px] text-[#9CA3AF] block">Make</span>
                <span id="hw-make" class="text-xs font-bold text-white font-mono truncate block">--</span>
              </div>
              <div class="p-2 rounded-xl bg-[#0c0507] border border-red-950">
                <span class="text-[10px] text-[#9CA3AF] block">Model</span>
                <span id="hw-model" class="text-xs font-bold text-white font-mono truncate block">--</span>
              </div>
              <div class="p-2 rounded-xl bg-[#0c0507] border border-red-950 col-span-2">
                <span class="text-[10px] text-[#9CA3AF] block">Lens</span>
                <span id="hw-lens" class="text-xs font-semibold text-red-300 font-mono break-all">--</span>
              </div>
              <div class="p-2 rounded-xl bg-[#0c0507] border border-red-950">
                <span class="text-[10px] text-[#9CA3AF] block">Software OS</span>
                <span id="hw-software" class="text-xs font-semibold text-gray-200 font-mono truncate block">--</span>
              </div>
              <div class="p-2 rounded-xl bg-red-950/40 border border-red-500/40">
                <span class="text-[10px] text-red-300 block font-bold">Serial Number</span>
                <span id="hw-serial" class="text-xs font-extrabold text-red-400 font-mono truncate block">--</span>
              </div>
            </div>
          </div>

          <!-- TAB 3: Exposure -->
          <div id="tab-content-exposure" class="tab-pane hidden space-y-2">
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
              <div class="p-2 rounded-xl bg-[#0c0507] border border-red-950 col-span-2 sm:col-span-3">
                <span class="text-[10px] text-[#9CA3AF] block">Original Timestamp</span>
                <span id="exp-date" class="text-xs font-bold text-white font-mono">--</span>
              </div>
              <div class="p-2 rounded-xl bg-[#0c0507] border border-red-950">
                <span class="text-[10px] text-[#9CA3AF] block">ISO</span>
                <span id="exp-iso" class="text-xs font-bold text-white font-mono">--</span>
              </div>
              <div class="p-2 rounded-xl bg-[#0c0507] border border-red-950">
                <span class="text-[10px] text-[#9CA3AF] block">Aperture</span>
                <span id="exp-aperture" class="text-xs font-bold text-white font-mono">--</span>
              </div>
              <div class="p-2 rounded-xl bg-[#0c0507] border border-red-950">
                <span class="text-[10px] text-[#9CA3AF] block">Shutter</span>
                <span id="exp-shutter" class="text-xs font-bold text-white font-mono">--</span>
              </div>
            </div>
          </div>

          <!-- TAB 4: Raw Tag Inspector Table -->
          <div id="tab-content-raw" class="tab-pane hidden space-y-2">
            <div class="flex items-center justify-between gap-2">
              <span class="text-[11px] text-[#9CA3AF]">Tags: <strong id="raw-count-text" class="text-white">0</strong></span>
              <input 
                id="raw-filter-input" 
                type="text" 
                placeholder="Filter tags..." 
                class="bg-[#0c0507] border border-red-900/50 rounded-lg px-2 py-0.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-red-500 max-w-[130px]"
              />
            </div>
            <div class="max-h-52 overflow-y-auto rounded-xl border border-red-950 bg-[#030102] p-1.5 font-mono text-xs">
              <table class="w-full text-left">
                <thead>
                  <tr class="text-gray-500 border-b border-red-950 text-[10px]">
                    <th class="py-1 px-1.5">Tag</th>
                    <th class="py-1 px-1.5">Value</th>
                  </tr>
                </thead>
                <tbody id="raw-tags-tbody" class="divide-y divide-red-950">
                  <!-- Rendered dynamically -->
                </tbody>
              </table>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import JSZip from 'jszip';
  import { inspectImageFile, type ImageMetadataInspection } from '../utils/exifParser';
  import { stripImageMetadata, type CleanResult } from '../utils/imageCleaner';
  import { createDemoPhotoFile } from '../utils/sampleDemoPhoto';

  interface QueuedImage {
    id: string;
    file: File;
    previewUrl: string;
    inspection: ImageMetadataInspection;
    cleanedResult: CleanResult | null;
    isCleaning: boolean;
  }

  // State
  let queue: QueuedImage[] = [];
  let activeIndex: number = 0;

  // DOM Elements
  const dropZone = document.getElementById('drop-zone') as HTMLDivElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const btnLoadSample = document.getElementById('btn-load-sample') as HTMLButtonElement;
  const btnClearAll = document.getElementById('btn-clear-all') as HTMLButtonElement;
  const processingLoader = document.getElementById('processing-loader') as HTMLDivElement;
  const loaderStatusText = document.getElementById('loader-status-text') as HTMLHeadingElement;
  const workspaceContainer = document.getElementById('workspace-container') as HTMLDivElement;
  const queueCountBadge = document.getElementById('queue-count-badge') as HTMLSpanElement;
  const thumbnailStrip = document.getElementById('thumbnail-strip') as HTMLDivElement;
  const selectFormat = document.getElementById('select-format') as HTMLSelectElement;
  const btnCleanAll = document.getElementById('btn-clean-all') as HTMLButtonElement;
  const btnDownloadZip = document.getElementById('btn-download-zip') as HTMLButtonElement;

  // Active Item Elements
  const activeFilename = document.getElementById('active-filename') as HTMLSpanElement;
  const activeDimensions = document.getElementById('active-dimensions') as HTMLSpanElement;
  const activePreviewImg = document.getElementById('active-preview-img') as HTMLImageElement;
  const cleanedStampBadge = document.getElementById('cleaned-stamp-badge') as HTMLDivElement;
  const threatScoreNumber = document.getElementById('threat-score-number') as HTMLSpanElement;
  const threatScoreBar = document.getElementById('threat-score-bar') as HTMLDivElement;
  const threatBadgeContainer = document.getElementById('threat-badge-container') as HTMLDivElement;
  const threatBadgeIcon = document.getElementById('threat-badge-icon') as HTMLSpanElement;
  const threatBadgeText = document.getElementById('threat-badge-text') as HTMLSpanElement;
  const btnCleanSingle = document.getElementById('btn-clean-single') as HTMLButtonElement;
  const btnDownloadSingle = document.getElementById('btn-download-single') as HTMLAnchorElement;

  // Diff Metrics
  const diffStatusLabel = document.getElementById('diff-status-label') as HTMLSpanElement;
  const diffBeforeTags = document.getElementById('diff-before-tags') as HTMLDivElement;
  const diffBeforeGps = document.getElementById('diff-before-gps') as HTMLSpanElement;
  const diffAfterTags = document.getElementById('diff-after-tags') as HTMLDivElement;
  const diffAfterStatus = document.getElementById('diff-after-status') as HTMLSpanElement;

  // Tabs
  const tabButtons = document.querySelectorAll('.tab-btn');
  const tabPanes = document.querySelectorAll('.tab-pane');
  const tabGpsCount = document.getElementById('tab-gps-count') as HTMLSpanElement;

  // GPS fields
  const gpsAlertBox = document.getElementById('gps-alert-box') as HTMLDivElement;
  const gpsAlertText = document.getElementById('gps-alert-text') as HTMLParagraphElement;
  const gpsValLat = document.getElementById('gps-val-lat') as HTMLSpanElement;
  const gpsValLng = document.getElementById('gps-val-lng') as HTMLSpanElement;
  const gpsValDms = document.getElementById('gps-val-dms') as HTMLSpanElement;
  const gpsMapLinksContainer = document.getElementById('gps-map-links-container') as HTMLDivElement;
  const linkGoogleMaps = document.getElementById('link-google-maps') as HTMLAnchorElement;
  const linkOsm = document.getElementById('link-osm') as HTMLAnchorElement;
  const gpsEmptyState = document.getElementById('gps-empty-state') as HTMLDivElement;

  // Hardware fields
  const hwMake = document.getElementById('hw-make') as HTMLSpanElement;
  const hwModel = document.getElementById('hw-model') as HTMLSpanElement;
  const hwLens = document.getElementById('hw-lens') as HTMLSpanElement;
  const hwSoftware = document.getElementById('hw-software') as HTMLSpanElement;
  const hwSerial = document.getElementById('hw-serial') as HTMLSpanElement;

  // Exposure fields
  const expDate = document.getElementById('exp-date') as HTMLSpanElement;
  const expIso = document.getElementById('exp-iso') as HTMLSpanElement;
  const expAperture = document.getElementById('exp-aperture') as HTMLSpanElement;
  const expShutter = document.getElementById('exp-shutter') as HTMLSpanElement;

  // Raw inspector
  const rawCountText = document.getElementById('raw-count-text') as HTMLElement;
  const rawTagsTbody = document.getElementById('raw-tags-tbody') as HTMLTableSectionElement;
  const rawFilterInput = document.getElementById('raw-filter-input') as HTMLInputElement;

  // Drag & Drop
  ['dragenter', 'dragover'].forEach(name => {
    dropZone.addEventListener(name, (e) => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.add('border-red-500', 'bg-[#1c0a0e]', 'neon-glow-red');
    });
  });

  ['dragleave', 'drop'].forEach(name => {
    dropZone.addEventListener(name, (e) => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.remove('border-red-500', 'bg-[#1c0a0e]', 'neon-glow-red');
    });
  });

  dropZone.addEventListener('drop', (e: DragEvent) => {
    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
      handleFiles(Array.from(e.dataTransfer.files));
    }
  });

  dropZone.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.tagName !== 'BUTTON' && !target.closest('button')) {
      fileInput.click();
    }
  });

  fileInput.addEventListener('change', () => {
    if (fileInput.files && fileInput.files.length > 0) {
      handleFiles(Array.from(fileInput.files));
      fileInput.value = '';
    }
  });

  btnLoadSample.addEventListener('click', async () => {
    const demoFile = createDemoPhotoFile();
    await handleFiles([demoFile]);
  });

  btnClearAll.addEventListener('click', () => {
    queue.forEach(item => {
      URL.revokeObjectURL(item.previewUrl);
      if (item.cleanedResult) URL.revokeObjectURL(item.cleanedResult.cleanedUrl);
    });
    queue = [];
    activeIndex = 0;
    updateWorkspaceVisibility();
  });

  // Tab switching
  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tabTarget = btn.getAttribute('data-tab');
      tabButtons.forEach(b => {
        b.classList.remove('active', 'bg-red-600/30', 'border-red-500/50', 'text-white');
        b.classList.add('text-[#9CA3AF]');
      });
      btn.classList.add('active', 'bg-red-600/30', 'border-red-500/50', 'text-white');
      btn.classList.remove('text-[#9CA3AF]');

      tabPanes.forEach(pane => {
        if (pane.id === `tab-content-${tabTarget}`) {
          pane.classList.remove('hidden');
        } else {
          pane.classList.add('hidden');
        }
      });
    });
  });

  // Filter raw tags
  rawFilterInput.addEventListener('input', () => {
    const query = rawFilterInput.value.toLowerCase().trim();
    const rows = rawTagsTbody.querySelectorAll('tr');
    rows.forEach(row => {
      const text = row.textContent?.toLowerCase() || '';
      row.style.display = text.includes(query) ? '' : 'none';
    });
  });

  // Handle files
  async function handleFiles(files: File[]) {
    const validFiles = files.filter(f => f.type.startsWith('image/') || f.name.match(/\.(jpg|jpeg|png|webp|tiff)$/i));
    if (validFiles.length === 0) return;

    processingLoader.classList.remove('hidden');
    loaderStatusText.textContent = `Analyzing ${validFiles.length} photo(s) in browser RAM...`;

    try {
      for (const file of validFiles) {
        const previewUrl = URL.createObjectURL(file);
        const inspection = await inspectImageFile(file);

        queue.push({
          id: Math.random().toString(36).substring(2, 9),
          file,
          previewUrl,
          inspection,
          cleanedResult: null,
          isCleaning: false
        });
      }

      activeIndex = queue.length - validFiles.length;
      if (activeIndex < 0) activeIndex = 0;

      updateWorkspaceVisibility();
      renderThumbnailStrip();
      renderActiveItem();
    } finally {
      processingLoader.classList.add('hidden');
    }
  }

  function updateWorkspaceVisibility() {
    if (queue.length > 0) {
      workspaceContainer.classList.remove('hidden');
      btnClearAll.classList.remove('hidden');
      btnClearAll.classList.add('inline-flex');
      queueCountBadge.textContent = `${queue.length} photo${queue.length > 1 ? 's' : ''}`;
    } else {
      workspaceContainer.classList.add('hidden');
      btnClearAll.classList.add('hidden');
      btnClearAll.classList.remove('inline-flex');
    }
    updateZipButtonVisibility();
  }

  function updateZipButtonVisibility() {
    const hasAnyCleaned = queue.some(item => item.cleanedResult !== null);
    if (hasAnyCleaned) {
      btnDownloadZip.classList.remove('hidden');
      btnDownloadZip.classList.add('inline-flex');
    } else {
      btnDownloadZip.classList.add('hidden');
      btnDownloadZip.classList.remove('inline-flex');
    }
  }

  function renderThumbnailStrip() {
    thumbnailStrip.innerHTML = '';
    queue.forEach((item, idx) => {
      const thumb = document.createElement('div');
      thumb.className = `relative flex-shrink-0 w-16 h-16 sm:w-20 sm:h-20 rounded-xl overflow-hidden cursor-pointer border-2 transition-all duration-200 ${
        idx === activeIndex
          ? 'border-red-500 shadow-[0_0_12px_rgba(239,68,68,0.6)] scale-105'
          : 'border-red-950 hover:border-red-800 opacity-75 hover:opacity-100'
      }`;

      const img = document.createElement('img');
      img.src = item.previewUrl;
      img.alt = item.file.name;
      img.className = 'w-full h-full object-cover';
      thumb.appendChild(img);

      // Threat Dot Badge
      const dot = document.createElement('div');
      dot.className = `absolute top-1 right-1 w-2.5 h-2.5 rounded-full border border-black/50 ${
        item.cleanedResult
          ? 'bg-red-400 shadow-[0_0_8px_#EF4444]'
          : item.inspection.threat.level === 'CRITICAL'
          ? 'bg-red-500 shadow-[0_0_8px_#EF4444] animate-pulse'
          : 'bg-red-400'
      }`;
      thumb.appendChild(dot);

      thumb.addEventListener('click', () => {
        activeIndex = idx;
        renderThumbnailStrip();
        renderActiveItem();
      });

      thumbnailStrip.appendChild(thumb);
    });
  }

  function renderActiveItem() {
    const item = queue[activeIndex];
    if (!item) return;

    activeFilename.textContent = item.file.name;
    activePreviewImg.src = item.cleanedResult ? item.cleanedResult.cleanedUrl : item.previewUrl;

    // Dimensions
    if (item.cleanedResult) {
      activeDimensions.textContent = `${item.cleanedResult.originalDimensions.width} × ${item.cleanedResult.originalDimensions.height} px`;
    } else if (item.inspection.exposure.dimensions) {
      activeDimensions.textContent = item.inspection.exposure.dimensions;
    } else {
      activeDimensions.textContent = `${(item.file.size / 1024).toFixed(1)} KB`;
    }

    // Cleaned Stamp Badge
    if (item.cleanedResult) {
      cleanedStampBadge.classList.remove('hidden');
      cleanedStampBadge.classList.add('flex');
    } else {
      cleanedStampBadge.classList.add('hidden');
      cleanedStampBadge.classList.remove('flex');
    }

    // Threat Score & Badge
    if (item.cleanedResult) {
      threatScoreNumber.textContent = "Threat: 0/100 (Safe)";
      threatScoreNumber.className = "text-[11px] font-mono font-bold text-gray-200";
      threatScoreBar.style.width = "0%";
      threatScoreBar.className = "h-full rounded-full bg-red-950 transition-all duration-500";
      threatBadgeContainer.className = "p-2 rounded-lg text-xs font-bold border flex items-center gap-1.5 bg-[#1c0a0e] border-red-500/40 text-white shadow-sm";
      threatBadgeIcon.textContent = "🛡️";
      threatBadgeText.textContent = "PRIVACY VAULT SECURE: 0 Metadata Leaks Detected";
    } else {
      const t = item.inspection.threat;
      threatScoreNumber.textContent = `Score: ${t.score}/100`;
      threatScoreNumber.className = "text-[11px] font-mono font-extrabold text-red-400";
      threatScoreBar.style.width = `${Math.max(5, t.score)}%`;
      threatScoreBar.className = "h-full rounded-full bg-gradient-to-r from-red-600 to-red-400 transition-all duration-500 shadow-[0_0_8px_#EF4444]";
      threatBadgeContainer.className = `p-2 rounded-lg text-xs font-bold border flex items-center gap-1.5 ${t.badgeClass} ${t.badgeGlow}`;
      threatBadgeIcon.textContent = "🔴";
      threatBadgeText.textContent = "🔴 HIGH PRIVACY RISK: EXIF & GPS Location Data Detected";
    }

    // Buttons
    if (item.cleanedResult) {
      btnCleanSingle.classList.add('hidden');
      btnDownloadSingle.classList.remove('hidden');
      btnDownloadSingle.classList.add('flex');
      btnDownloadSingle.href = item.cleanedResult.cleanedUrl;
      btnDownloadSingle.download = item.cleanedResult.filename;
    } else {
      btnCleanSingle.classList.remove('hidden');
      btnDownloadSingle.classList.add('hidden');
      btnDownloadSingle.classList.remove('flex');
    }

    // Diff Card Metrics
    diffBeforeTags.textContent = `${item.inspection.totalTagsCount} tags`;
    diffBeforeGps.textContent = item.inspection.gps.hasGps ? `GPS: 📍 Exposed` : 'GPS: None';

    if (item.cleanedResult) {
      diffStatusLabel.textContent = "Sanitized";
      diffStatusLabel.className = "text-[10px] font-mono px-1.5 py-0.5 rounded bg-red-950/80 border border-red-500/40 text-white";
      diffAfterTags.textContent = `${item.cleanedResult.verifiedTagsCount} tags`;
      diffAfterStatus.textContent = "100% Sanitized (0 leaks)";
    } else {
      diffStatusLabel.textContent = "Awaiting Scrub";
      diffStatusLabel.className = "text-[10px] font-mono px-1.5 py-0.5 rounded bg-[#0c0507] text-[#9CA3AF] border border-red-950";
      diffAfterTags.textContent = "Pending";
      diffAfterStatus.textContent = "Will strip all EXIF";
    }

    // Tab 1: GPS
    const gps = item.inspection.gps;
    if (item.cleanedResult) {
      gpsAlertBox.classList.add('hidden');
      gpsEmptyState.classList.remove('hidden');
      gpsMapLinksContainer.classList.add('hidden');
      gpsValLat.textContent = "None (Stripped)";
      gpsValLng.textContent = "None (Stripped)";
      gpsValDms.textContent = "None";
      tabGpsCount.textContent = "0";
      tabGpsCount.className = "px-1 py-0.2 rounded-full bg-red-950 border border-red-500/30 text-gray-400 text-[9px]";
    } else if (gps.hasGps && gps.latitude !== null && gps.longitude !== null) {
      gpsAlertBox.classList.remove('hidden');
      gpsEmptyState.classList.add('hidden');
      gpsMapLinksContainer.classList.remove('hidden');
      gpsValLat.textContent = `${gps.latitude.toFixed(6)}° ${gps.latitudeRef}`;
      gpsValLng.textContent = `${gps.longitude.toFixed(6)}° ${gps.longitudeRef}`;
      gpsValDms.textContent = `${gps.dmsLat || ''}, ${gps.dmsLng || ''}`;
      linkGoogleMaps.href = gps.googleMapsUrl || '#';
      linkOsm.href = gps.osmUrl || '#';
      tabGpsCount.textContent = "!";
      tabGpsCount.className = "px-1 py-0.2 rounded-full bg-red-950 border border-red-500/60 text-red-300 text-[9px] animate-pulse";
    } else {
      gpsAlertBox.classList.add('hidden');
      gpsEmptyState.classList.remove('hidden');
      gpsMapLinksContainer.classList.add('hidden');
      gpsValLat.textContent = "None detected";
      gpsValLng.textContent = "None detected";
      gpsValDms.textContent = "None";
      tabGpsCount.textContent = "0";
      tabGpsCount.className = "px-1 py-0.2 rounded-full bg-[#1c0a0e] text-gray-500 text-[9px]";
    }

    // Tab 2: Hardware
    const hw = item.cleanedResult ? {} : item.inspection.hardware;
    hwMake.textContent = hw.make || 'None';
    hwModel.textContent = hw.model || 'None';
    hwLens.textContent = hw.lensModel || 'None detected';
    hwSoftware.textContent = hw.software || 'None';
    hwSerial.textContent = hw.serialNumber || 'None';

    // Tab 3: Exposure
    const exp = item.cleanedResult ? {} : item.inspection.exposure;
    expDate.textContent = exp.dateTimeOriginal || 'None';
    expIso.textContent = exp.iso || 'None';
    expAperture.textContent = exp.fNumber || 'None';
    expShutter.textContent = exp.shutterSpeed || 'None';

    // Tab 4: Raw Tags
    rawTagsTbody.innerHTML = '';
    const tags = item.cleanedResult ? [] : item.inspection.rawTags;
    rawCountText.textContent = String(tags.length);
    if (tags.length === 0) {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td colspan="2" class="py-3 text-center text-gray-500 italic text-xs">No EXIF/metadata tags remaining</td>`;
      rawTagsTbody.appendChild(tr);
    } else {
      tags.forEach(t => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-red-950/30 transition-colors';
        tr.innerHTML = `
          <td class="py-1 px-1.5 text-red-400 font-mono text-[10px] whitespace-nowrap">${t.tag}</td>
          <td class="py-1 px-1.5 text-gray-300 font-mono text-[10px] break-all">${t.value}</td>
        `;
        rawTagsTbody.appendChild(tr);
      });
    }

    // Sync mobile action bar
    window.dispatchEvent(new CustomEvent('cleanphoto:active-change', {
      detail: {
        hasCleaned: Boolean(item.cleanedResult),
        cleanedUrl: item.cleanedResult?.cleanedUrl,
        filename: item.cleanedResult?.filename,
        totalInQueue: queue.length
      }
    }));
  }

  // Clean Single Image
  btnCleanSingle.addEventListener('click', async () => {
    const item = queue[activeIndex];
    if (!item || item.isCleaning) return;

    item.isCleaning = true;
    btnCleanSingle.disabled = true;
    btnCleanSingle.innerHTML = `<span class="inline-block w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span> In RAM...`;

    try {
      const format = selectFormat.value as any;
      const res = await stripImageMetadata(item.file, item.file.name, { outputFormat: format });
      item.cleanedResult = res;

      renderThumbnailStrip();
      renderActiveItem();
      updateZipButtonVisibility();
    } catch (err) {
      console.error("Stripping error:", err);
      alert("Failed to strip metadata: " + (err as Error).message);
    } finally {
      item.isCleaning = false;
      btnCleanSingle.disabled = false;
    }
  });

  // Clean All Batch Action
  btnCleanAll.addEventListener('click', async () => {
    if (queue.length === 0) return;

    btnCleanAll.disabled = true;
    const originalText = btnCleanAll.innerHTML;
    btnCleanAll.innerHTML = `<span class="inline-block w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin"></span> Processing...`;

    const format = selectFormat.value as any;

    for (let i = 0; i < queue.length; i++) {
      const item = queue[i];
      if (!item.cleanedResult) {
        try {
          const res = await stripImageMetadata(item.file, item.file.name, { outputFormat: format });
          item.cleanedResult = res;
        } catch (err) {
          console.error("Batch strip error on item", i, err);
        }
      }
    }

    btnCleanAll.innerHTML = originalText;
    btnCleanAll.disabled = false;

    renderThumbnailStrip();
    renderActiveItem();
    updateZipButtonVisibility();
  });

  // Download All as ZIP
  btnDownloadZip.addEventListener('click', async () => {
    const cleanedItems = queue.filter(item => item.cleanedResult !== null);
    if (cleanedItems.length === 0) {
      alert("Please scrub your photos before downloading ZIP.");
      return;
    }

    btnDownloadZip.disabled = true;
    const origText = btnDownloadZip.innerHTML;
    btnDownloadZip.innerHTML = `<span class="inline-block w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span> Bundling...`;

    try {
      const zip = new JSZip();

      cleanedItems.forEach((item) => {
        if (item.cleanedResult) {
          zip.file(item.cleanedResult.filename, item.cleanedResult.cleanedBlob);
        }
      });

      const certText = `CleanPhoto Privacy Vault Metadata Sanitization Audit
Generated by: cleanphoto.fixeehub.com
Date: ${new Date().toISOString()}

All images bundled in this archive were stripped of 100% EXIF, IPTC, XMP, GPS coordinates, and camera body serial numbers locally in client-side RAM using HTML5 Canvas.
Zero bytes were transmitted to any remote server or cloud API.
`;
      zip.file("PRIVACY_AUDIT_REPORT.txt", certText);

      const content = await zip.generateAsync({ type: 'blob' });
      const zipUrl = URL.createObjectURL(content);

      const a = document.createElement('a');
      a.href = zipUrl;
      a.download = `cleanphoto_vault_${Date.now()}.zip`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);

      setTimeout(() => URL.revokeObjectURL(zipUrl), 5000);
    } catch (err) {
      console.error("ZIP creation failed:", err);
      alert("ZIP generation failed: " + (err as Error).message);
    } finally {
      btnDownloadZip.innerHTML = origText;
      btnDownloadZip.disabled = false;
    }
  });
</script>
