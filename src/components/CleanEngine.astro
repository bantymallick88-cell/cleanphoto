---
// CleanEngine.astro - Linear / Vercel Floating Scrubber Card with Live Before/After Audit
---

<div id="clean-engine" class="w-full max-w-3xl mx-auto px-4 py-2 scroll-mt-20">
  
  <!-- Scrubber Dropzone Card Container with Ambient Red Glow -->
  <div class="glass-panel rounded-2xl p-5 sm:p-6 transition-all border-rose-500/20 shadow-[0_0_50px_-15px_rgba(225,29,72,0.12)]">
    
    <!-- Card Header -->
    <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/[0.08]">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
        <h2 class="text-sm sm:text-base font-semibold text-white tracking-tight">EXIF Threat Scrubber</h2>
      </div>

      <div class="flex items-center gap-2">
        <button
          id="btn-load-sample"
          type="button"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.1] text-slate-300 hover:text-white text-xs font-mono transition-all active:scale-95"
        >
          <span class="text-rose-400">⚡</span>
          <span>Load Demo Sample</span>
        </button>

        <button
          id="btn-clear-all"
          type="button"
          class="hidden items-center gap-1 px-2.5 py-1 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.1] text-slate-400 hover:text-rose-400 text-xs font-mono transition-all"
          title="Reset files"
        >
          Reset
        </button>
      </div>
    </div>

    <!-- Dropzone Visual (High-Tech Security Scanner with Glowing Pulse Animation) -->
    <div 
      id="drop-zone"
      class="border-2 border-dashed border-rose-500/30 hover:border-rose-500/70 bg-gradient-to-b from-rose-950/10 via-neutral-950/40 to-neutral-950/80 transition-all duration-300 rounded-2xl p-8 sm:p-11 text-center cursor-pointer group relative overflow-hidden shadow-[0_0_35px_-10px_rgba(225,29,72,0.12)] hover:shadow-[0_0_45px_-5px_rgba(225,29,72,0.28)]"
    >
      <!-- Hidden File Input -->
      <input 
        type="file" 
        id="file-input" 
        multiple 
        accept="image/jpeg, image/jpg, image/png, image/webp, image/heic, image/heif, image/avif" 
        class="hidden" 
      />

      <div class="flex flex-col items-center justify-center pointer-events-none">
        <!-- High-Tech Security Scanner Aperture Icon -->
        <div id="dropzone-icon-box" class="w-14 h-14 mb-3.5 rounded-2xl bg-neutral-900/90 border border-neutral-800 flex items-center justify-center text-neutral-400 group-hover:text-rose-400 group-hover:border-rose-500/50 group-hover:scale-105 shadow-inner transition-all duration-300">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
          </svg>
        </div>

        <h3 id="dropzone-title" class="text-base sm:text-lg font-bold text-white mb-1 tracking-tight">
          Drop your photo here to scan & scrub
        </h3>
        <p id="dropzone-subtitle" class="text-xs text-neutral-400 max-w-sm mx-auto mb-4 leading-normal">
          Instant in-memory privacy scan • Zero cloud upload
        </p>

        <!-- White Primary CTA Button -->
        <button
          type="button"
          id="btn-browse-trigger"
          class="pointer-events-auto inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white hover:bg-neutral-200 text-neutral-950 font-bold text-xs sm:text-sm transition-all shadow-md active:scale-95 mb-4 cursor-pointer"
        >
          <svg class="w-4 h-4 text-neutral-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
          </svg>
          <span>Browse Device</span>
        </button>

        <!-- Clear, Elegant Format Pill Badges: JPG · PNG · WEBP · HEIC · AVIF (Up to 100MB) -->
        <div class="flex flex-wrap items-center justify-center gap-1.5 text-[10px] sm:text-[11px] font-mono">
          <span class="bg-neutral-900/90 border border-neutral-800 px-2 py-0.5 rounded text-neutral-300 font-medium">JPG</span>
          <span class="bg-neutral-900/90 border border-neutral-800 px-2 py-0.5 rounded text-neutral-300 font-medium">PNG</span>
          <span class="bg-neutral-900/90 border border-neutral-800 px-2 py-0.5 rounded text-neutral-300 font-medium">WEBP</span>
          <span class="bg-neutral-900/90 border border-neutral-800 px-2 py-0.5 rounded text-neutral-300 font-medium">HEIC</span>
          <span class="bg-neutral-900/90 border border-neutral-800 px-2 py-0.5 rounded text-neutral-300 font-medium">AVIF</span>
          <span class="text-neutral-500 ml-1">(Up to 100MB)</span>
        </div>
      </div>
    </div>

    <!-- Loading State Indicator -->
    <div id="processing-loader" class="hidden my-4 p-4 rounded-xl bg-neutral-900/40 border border-neutral-800 text-center">
      <div class="inline-flex items-center justify-center w-8 h-8 rounded-full border-2 border-rose-500 border-t-transparent animate-spin mb-2"></div>
      <h4 id="loader-status-text" class="text-xs font-semibold text-white">Inspecting EXIF Metadata...</h4>
      <p class="text-[10px] text-neutral-400 mt-0.5 font-mono">Parsing memory buffers locally</p>
    </div>

    <!-- Active Work Area (Queue & Clean View) -->
    <div id="workspace-container" class="hidden mt-6 space-y-4">
      
      <!-- Toolbar: Queue count + Clean Batch Actions -->
      <div class="p-3 rounded-xl bg-neutral-900/40 border border-neutral-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold text-white">Queue:</span>
          <span id="queue-count-badge" class="px-2 py-0.5 rounded bg-neutral-800 text-neutral-300 text-[11px] font-mono">
            0 files
          </span>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button
            id="btn-clean-all"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white hover:bg-neutral-200 text-neutral-950 font-semibold text-xs transition-all active:scale-95 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 text-neutral-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Scrub All Files</span>
          </button>

          <button
            id="btn-download-zip"
            type="button"
            class="hidden inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-white font-semibold text-xs transition-all active:scale-95 cursor-pointer border border-neutral-700"
          >
            <svg class="w-3.5 h-3.5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
            </svg>
            <span>Download All (.ZIP)</span>
          </button>
        </div>
      </div>

      <!-- Thumbnails Strip -->
      <div id="thumbnail-strip" class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-thin">
        <!-- Rendered dynamically -->
      </div>

      <!-- Selected Image Inspector Details (Ultra-Clean Single Card) -->
      <div id="inspector-card" class="max-w-xl mx-auto w-full pt-1">
        <div class="p-4 sm:p-5 rounded-2xl bg-neutral-900/50 border border-neutral-800/80 backdrop-blur-xl space-y-4">
          <!-- File info header -->
          <div class="flex items-center justify-between gap-2">
            <span id="active-filename" class="text-xs sm:text-sm font-semibold text-white truncate max-w-[240px]">
              photo.jpg
            </span>
            <span id="active-dimensions" class="text-[10px] sm:text-xs font-mono px-2 py-0.5 rounded bg-neutral-950 text-neutral-400 border border-neutral-800 flex-shrink-0">
              -- × --
            </span>
          </div>

          <!-- Preview Box with 1-Click Lightbox Trigger -->
          <div 
            id="preview-trigger-container"
            class="relative rounded-xl overflow-hidden bg-neutral-950 border border-neutral-900 flex items-center justify-center min-h-[200px] max-h-[340px] cursor-pointer group/preview"
            title="Click to view full preview"
          >
            <img 
              id="active-preview-img" 
              src="" 
              alt="Photo preview" 
              class="max-w-full max-h-[320px] object-contain rounded transition-transform duration-300 group-hover/preview:scale-[1.02]" 
            />

            <!-- Cleaned Stamp Badge -->
            <div id="cleaned-stamp-badge" class="hidden absolute top-3 right-3 px-2.5 py-1 rounded-full bg-emerald-950/90 border border-emerald-500/40 text-emerald-400 text-[11px] font-mono font-semibold items-center gap-1.5 shadow-md">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>SANITIZED</span>
            </div>

            <!-- 1-Click Preview Hint Pill -->
            <div class="absolute bottom-2.5 right-2.5 opacity-0 group-hover/preview:opacity-100 transition-opacity bg-black/80 backdrop-blur-md border border-white/10 px-2.5 py-1 rounded-lg text-[10px] font-mono text-slate-300 flex items-center gap-1.5 pointer-events-none">
              <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
              </svg>
              <span>1-Click Full Preview</span>
            </div>
          </div>

          <!-- Simple Visual Status Pill -->
          <div id="threat-badge-container" class="py-2.5 px-4 rounded-xl text-xs sm:text-sm font-bold border transition-all flex items-center justify-center gap-2 text-center">
            <span id="threat-badge-icon" class="text-sm flex-shrink-0">🔴</span>
            <span id="threat-badge-text" class="tracking-wide">Hidden Metadata Detected — Scrubbing Required</span>
          </div>

          <!-- Action Button: Modern Glassmorphic Action Button -->
          <div class="pt-1">
            <button
              id="btn-clean-single"
              type="button"
              class="w-full py-3.5 sm:py-4 px-6 rounded-2xl bg-gradient-to-r from-rose-600 to-red-600 hover:from-rose-500 hover:to-red-500 shadow-lg shadow-rose-600/30 text-white font-bold text-sm sm:text-base tracking-wide backdrop-blur-md transition-all active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer"
            >
              <span id="btn-clean-single-text" class="flex items-center justify-center gap-2">
                <span>✨</span>
                <span>Clean Metadata & Save Photo</span>
              </span>
            </button>
          </div>

          <!-- 1. Live Before/After Metadata Inspector (Expandable Accordion) -->
          <div id="metadata-comparison-card" class="pt-2 border-t border-white/[0.08] transition-all duration-300">
            <button
              id="btn-toggle-comparison"
              type="button"
              class="w-full flex items-center justify-between py-2 px-3 rounded-xl bg-white/[0.03] hover:bg-white/[0.06] border border-white/[0.08] text-xs font-mono text-slate-300 transition-colors cursor-pointer group"
            >
              <div class="flex items-center gap-2">
                <span class="text-emerald-400 group-hover:scale-110 transition-transform">🔍</span>
                <span class="font-semibold text-white">Inspected Metadata Audit</span>
                <span class="text-[10px] text-slate-400 px-1.5 py-0.2 rounded bg-neutral-900 border border-neutral-800">Before vs After</span>
              </div>
              <svg id="comparison-chevron" class="w-4 h-4 text-slate-400 group-hover:text-white transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Collapsible Comparison Pane -->
            <div id="comparison-content" class="hidden mt-3 space-y-3">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                
                <!-- EXIF Before (Red Accent) -->
                <div class="p-3.5 rounded-xl bg-rose-950/20 border border-rose-500/30 text-left space-y-2">
                  <div class="flex items-center justify-between border-b border-rose-500/20 pb-1.5">
                    <span class="font-bold text-rose-300 flex items-center gap-1.5 font-mono text-[11px]">
                      <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                      EXIF BEFORE (ORIGINAL)
                    </span>
                    <span class="text-[10px] font-mono text-rose-400/80">Raw Leaks</span>
                  </div>
                  
                  <div class="space-y-1.5 font-mono text-[11px]">
                    <div>
                      <span class="text-slate-400 block text-[10px]">GPS Coordinates:</span>
                      <span id="compare-before-gps" class="text-amber-300/90 break-all">Hidden / Raw Metadata Tags Present (Unverified Risk)</span>
                    </div>
                    <div>
                      <span class="text-slate-400 block text-[10px]">Device / Model:</span>
                      <span id="compare-before-device" class="text-amber-300/90 truncate block">Hidden / Raw Metadata Tags Present (Unverified Risk)</span>
                    </div>
                    <div>
                      <span class="text-slate-400 block text-[10px]">Camera Serial:</span>
                      <span id="compare-before-serial" class="text-amber-300/90 truncate block">Hidden / Raw Metadata Tags Present (Unverified Risk)</span>
                    </div>
                    <div>
                      <span class="text-slate-400 block text-[10px]">Creation Date:</span>
                      <span id="compare-before-date" class="text-amber-300/90 truncate block">Hidden / Raw Metadata Tags Present (Unverified Risk)</span>
                    </div>
                  </div>
                </div>

                <!-- EXIF After (Emerald Accent) -->
                <div class="p-3.5 rounded-xl bg-emerald-950/20 border border-emerald-500/30 text-left space-y-2">
                  <div class="flex items-center justify-between border-b border-emerald-500/20 pb-1.5">
                    <span class="font-bold text-emerald-300 flex items-center gap-1.5 font-mono text-[11px]">
                      <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#10B981]"></span>
                      EXIF AFTER (SANITIZED)
                    </span>
                    <span class="text-[10px] font-mono text-emerald-400/80">In-RAM Clean</span>
                  </div>

                  <div class="space-y-1.5 font-mono text-[11px]">
                    <div>
                      <span class="text-slate-400 block text-[10px]">GPS Coordinates:</span>
                      <span class="text-emerald-400 font-semibold flex items-center gap-1">
                        <span>✓</span> 100% EXIF & GPS Tags Purged (Safe to Share Online)
                      </span>
                    </div>
                    <div>
                      <span class="text-slate-400 block text-[10px]">Device / Model:</span>
                      <span class="text-emerald-400 font-semibold flex items-center gap-1">
                        <span>✓</span> 100% EXIF & GPS Tags Purged (Safe to Share Online)
                      </span>
                    </div>
                    <div>
                      <span class="text-slate-400 block text-[10px]">Camera Serial:</span>
                      <span class="text-emerald-400 font-semibold flex items-center gap-1">
                        <span>✓</span> 100% EXIF & GPS Tags Purged (Safe to Share Online)
                      </span>
                    </div>
                    <div>
                      <span class="text-slate-400 block text-[10px]">Creation Date:</span>
                      <span class="text-emerald-400 font-semibold flex items-center gap-1">
                        <span>✓</span> 100% EXIF & GPS Tags Purged (Safe to Share Online)
                      </span>
                    </div>
                  </div>
                </div>

              </div>

              <!-- Verdict Trust Badge -->
              <div class="p-2.5 rounded-lg bg-emerald-950/30 border border-emerald-500/25 text-[11px] font-mono text-emerald-300 text-center flex items-center justify-center gap-1.5">
                <span>🛡️</span>
                <span class="font-semibold">✓ 100% EXIF & GPS Tags Purged (Safe to Share Online)</span>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>

  <!-- 1-Click Lightbox Preview Modal -->
  <div
    id="preview-lightbox-modal"
    class="fixed inset-0 z-50 hidden bg-black/85 backdrop-blur-md items-center justify-center p-4 transition-opacity duration-200"
    role="dialog"
    aria-modal="true"
  >
    <div class="relative max-w-4xl max-h-[90vh] w-full bg-[#0e0e12] border border-white/[0.12] rounded-2xl p-4 sm:p-6 shadow-2xl flex flex-col items-center">
      <!-- Modal Header -->
      <div class="w-full flex items-center justify-between pb-3 border-b border-white/[0.08] mb-3">
        <div class="flex items-center gap-2 truncate">
          <span id="lightbox-status-badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-emerald-950/60 border border-emerald-500/30 text-emerald-400">
            SANITIZED PREVIEW
          </span>
          <span id="lightbox-filename" class="text-xs sm:text-sm font-semibold text-white truncate max-w-xs sm:max-w-md">
            photo.jpg
          </span>
        </div>
        <button
          type="button"
          id="btn-close-lightbox"
          class="p-1.5 rounded-lg bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.1] text-slate-400 hover:text-white transition-colors cursor-pointer"
          aria-label="Close preview"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Full-res image container -->
      <div class="w-full flex-1 min-h-0 flex items-center justify-center overflow-hidden rounded-xl bg-black/60 border border-neutral-900 p-2">
        <img
          id="lightbox-img"
          src=""
          alt="Enlarged photo preview"
          class="max-w-full max-h-[60vh] object-contain rounded-lg"
        />
      </div>

      <!-- Modal Footer -->
      <div class="w-full pt-3 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono text-slate-400">
        <span id="lightbox-dimensions">-- × --</span>
        <button
          type="button"
          id="btn-lightbox-download"
          class="w-full sm:w-auto px-4 py-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-semibold text-xs font-sans transition-all active:scale-95 cursor-pointer flex items-center justify-center gap-1.5 shadow-md"
        >
          <span>✓</span>
          <span id="lightbox-download-text">Download Cleaned Photo</span>
        </button>
      </div>
    </div>
  </div>

</div>

<script>
  import JSZip from 'jszip';
  import { inspectImageFile, type ImageMetadataInspection } from '../utils/exifParser';
  import { stripImageMetadata, type CleanResult } from '../utils/imageCleaner';
  import { isHeicFile, convertHeicToJpegBlob } from '../utils/heicHelper';
  import { createDemoPhotoFile } from '../utils/sampleDemoPhoto';

  interface QueuedImage {
    id: string;
    file: File;
    previewUrl: string;
    inspection: ImageMetadataInspection;
    cleanedResult: CleanResult | null;
    isCleaning: boolean;
  }

  let queue: QueuedImage[] = [];
  let activeIndex: number = 0;

  const dropZone = document.getElementById('drop-zone') as HTMLDivElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const btnBrowseTrigger = document.getElementById('btn-browse-trigger') as HTMLButtonElement;
  const btnLoadSample = document.getElementById('btn-load-sample') as HTMLButtonElement;
  const btnClearAll = document.getElementById('btn-clear-all') as HTMLButtonElement;
  const processingLoader = document.getElementById('processing-loader') as HTMLDivElement;
  const loaderStatusText = document.getElementById('loader-status-text') as HTMLHeadingElement;
  const workspaceContainer = document.getElementById('workspace-container') as HTMLDivElement;
  const queueCountBadge = document.getElementById('queue-count-badge') as HTMLSpanElement;
  const thumbnailStrip = document.getElementById('thumbnail-strip') as HTMLDivElement;
  const btnCleanAll = document.getElementById('btn-clean-all') as HTMLButtonElement;
  const btnDownloadZip = document.getElementById('btn-download-zip') as HTMLButtonElement;

  // Active Item Elements
  const activeFilename = document.getElementById('active-filename') as HTMLSpanElement;
  const activeDimensions = document.getElementById('active-dimensions') as HTMLSpanElement;
  const activePreviewImg = document.getElementById('active-preview-img') as HTMLImageElement;
  const previewTriggerContainer = document.getElementById('preview-trigger-container') as HTMLDivElement;
  const cleanedStampBadge = document.getElementById('cleaned-stamp-badge') as HTMLDivElement;
  const threatBadgeContainer = document.getElementById('threat-badge-container') as HTMLDivElement;
  const threatBadgeIcon = document.getElementById('threat-badge-icon') as HTMLSpanElement;
  const threatBadgeText = document.getElementById('threat-badge-text') as HTMLSpanElement;
  const btnCleanSingle = document.getElementById('btn-clean-single') as HTMLButtonElement;
  const btnCleanSingleText = document.getElementById('btn-clean-single-text') as HTMLSpanElement;

  // Before/After Inspection Elements
  const metadataComparisonCard = document.getElementById('metadata-comparison-card') as HTMLDivElement;
  const btnToggleComparison = document.getElementById('btn-toggle-comparison') as HTMLButtonElement;
  const comparisonChevron = document.getElementById('comparison-chevron') as unknown as SVGElement;
  const comparisonContent = document.getElementById('comparison-content') as HTMLDivElement;
  const compareBeforeGps = document.getElementById('compare-before-gps') as HTMLSpanElement;
  const compareBeforeDevice = document.getElementById('compare-before-device') as HTMLSpanElement;
  const compareBeforeSerial = document.getElementById('compare-before-serial') as HTMLSpanElement;
  const compareBeforeDate = document.getElementById('compare-before-date') as HTMLSpanElement;

  // Lightbox Modal Elements
  const lightboxModal = document.getElementById('preview-lightbox-modal') as HTMLDivElement;
  const lightboxStatusBadge = document.getElementById('lightbox-status-badge') as HTMLSpanElement;
  const lightboxFilename = document.getElementById('lightbox-filename') as HTMLSpanElement;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxDimensions = document.getElementById('lightbox-dimensions') as HTMLSpanElement;
  const btnCloseLightbox = document.getElementById('btn-close-lightbox') as HTMLButtonElement;
  const btnLightboxDownload = document.getElementById('btn-lightbox-download') as HTMLButtonElement;
  const lightboxDownloadText = document.getElementById('lightbox-download-text') as HTMLSpanElement;

  // Toggle comparison accordion
  let isComparisonOpen = false;
  btnToggleComparison.addEventListener('click', () => {
    isComparisonOpen = !isComparisonOpen;
    if (isComparisonOpen) {
      comparisonContent.classList.remove('hidden');
      comparisonChevron.classList.add('rotate-180');
    } else {
      comparisonContent.classList.add('hidden');
      comparisonChevron.classList.remove('rotate-180');
    }
  });

  // 1-Click Lightbox Preview open / close
  function openLightbox() {
    const item = queue[activeIndex];
    if (!item) return;

    lightboxFilename.textContent = item.file.name;
    const isCleaned = Boolean(item.cleanedResult);
    lightboxImg.src = isCleaned ? item.cleanedResult!.cleanedUrl : item.previewUrl;

    if (isCleaned) {
      lightboxStatusBadge.textContent = "100% SANITIZED PHOTO";
      lightboxStatusBadge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-emerald-950/80 border border-emerald-500/40 text-emerald-400";
      lightboxDimensions.textContent = `${item.cleanedResult!.originalDimensions.width} × ${item.cleanedResult!.originalDimensions.height} px`;
      lightboxDownloadText.textContent = "Download Cleaned Photo";
    } else {
      lightboxStatusBadge.textContent = "ORIGINAL PREVIEW (UNSANITIZED)";
      lightboxStatusBadge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-rose-950/80 border border-rose-500/40 text-rose-300";
      lightboxDimensions.textContent = item.inspection.exposure.dimensions || `${(item.file.size / 1024).toFixed(1)} KB`;
      lightboxDownloadText.textContent = "Clean & Save Photo";
    }

    lightboxModal.classList.remove('hidden');
    lightboxModal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightboxModal.classList.add('hidden');
    lightboxModal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  if (previewTriggerContainer) {
    previewTriggerContainer.addEventListener('click', openLightbox);
  }

  if (btnCloseLightbox) {
    btnCloseLightbox.addEventListener('click', closeLightbox);
  }

  if (lightboxModal) {
    lightboxModal.addEventListener('click', (e) => {
      if (e.target === lightboxModal) closeLightbox();
    });
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !lightboxModal.classList.contains('hidden')) {
      closeLightbox();
    }
  });

  if (btnLightboxDownload) {
    btnLightboxDownload.addEventListener('click', () => {
      closeLightbox();
      btnCleanSingle.click();
    });
  }

  // Dropzone Glow Animation on Drag Over
  ['dragenter', 'dragover'].forEach(name => {
    dropZone.addEventListener(name, (e) => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.add('border-emerald-400', 'bg-emerald-950/20', 'shadow-[0_0_50px_rgba(16,185,129,0.35)]', 'scale-[1.01]');
      dropZone.classList.remove('border-rose-500/30');
    });
  });

  ['dragleave', 'drop'].forEach(name => {
    dropZone.addEventListener(name, (e) => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.remove('border-emerald-400', 'bg-emerald-950/20', 'shadow-[0_0_50px_rgba(16,185,129,0.35)]', 'scale-[1.01]');
      dropZone.classList.add('border-rose-500/30');
    });
  });

  dropZone.addEventListener('drop', (e: DragEvent) => {
    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
      handleFiles(Array.from(e.dataTransfer.files));
    }
  });

  dropZone.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.id !== 'btn-browse-trigger' && !target.closest('#btn-browse-trigger')) {
      fileInput.click();
    }
  });

  if (btnBrowseTrigger) {
    btnBrowseTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.click();
    });
  }

  fileInput.addEventListener('change', () => {
    if (fileInput.files && fileInput.files.length > 0) {
      handleFiles(Array.from(fileInput.files));
      fileInput.value = '';
    }
  });

  btnLoadSample.addEventListener('click', async () => {
    const demoFile = createDemoPhotoFile();
    await handleFiles([demoFile]);
  });

  btnClearAll.addEventListener('click', () => {
    queue.forEach(item => {
      URL.revokeObjectURL(item.previewUrl);
      if (item.cleanedResult) URL.revokeObjectURL(item.cleanedResult.cleanedUrl);
    });
    queue = [];
    activeIndex = 0;
    updateWorkspaceVisibility();
  });

  async function handleFiles(files: File[]) {
    const validFiles = files.filter(f => f.type.startsWith('image/') || f.name.match(/\.(jpg|jpeg|png|webp|heic|heif|avif|tiff)$/i));
    if (validFiles.length === 0) return;

    processingLoader.classList.remove('hidden');
    loaderStatusText.textContent = `Analyzing ${validFiles.length} photo(s)...`;

    try {
      for (const file of validFiles) {
        let previewUrl: string;
        if (isHeicFile(file)) {
          try {
            const convertedBlob = await convertHeicToJpegBlob(file);
            previewUrl = URL.createObjectURL(convertedBlob);
          } catch {
            previewUrl = URL.createObjectURL(file);
          }
        } else {
          previewUrl = URL.createObjectURL(file);
        }

        const inspection = await inspectImageFile(file);

        queue.push({
          id: Math.random().toString(36).substring(2, 9),
          file,
          previewUrl,
          inspection,
          cleanedResult: null,
          isCleaning: false
        });
      }

      activeIndex = queue.length - validFiles.length;
      if (activeIndex < 0) activeIndex = 0;

      updateWorkspaceVisibility();
      renderThumbnailStrip();
      renderActiveItem();
    } finally {
      processingLoader.classList.add('hidden');
    }
  }

  function updateWorkspaceVisibility() {
    if (queue.length > 0) {
      workspaceContainer.classList.remove('hidden');
      btnClearAll.classList.remove('hidden');
      btnClearAll.classList.add('inline-flex');
      queueCountBadge.textContent = `${queue.length} photo${queue.length > 1 ? 's' : ''}`;
    } else {
      workspaceContainer.classList.add('hidden');
      btnClearAll.classList.add('hidden');
      btnClearAll.classList.remove('inline-flex');
    }
    updateZipButtonVisibility();
  }

  function updateZipButtonVisibility() {
    const hasAnyCleaned = queue.some(item => item.cleanedResult !== null);
    if (hasAnyCleaned) {
      btnDownloadZip.classList.remove('hidden');
      btnDownloadZip.classList.add('inline-flex');
    } else {
      btnDownloadZip.classList.add('hidden');
      btnDownloadZip.classList.remove('inline-flex');
    }
  }

  function renderThumbnailStrip() {
    thumbnailStrip.innerHTML = '';
    queue.forEach((item, idx) => {
      const thumb = document.createElement('div');
      thumb.className = `group relative flex-shrink-0 w-14 h-14 rounded-lg overflow-hidden cursor-pointer border transition-all ${
        idx === activeIndex
          ? 'border-white shadow-sm scale-105'
          : 'border-neutral-800 opacity-60 hover:opacity-100'
      }`;

      const img = document.createElement('img');
      img.src = item.previewUrl;
      img.alt = item.file.name;
      img.className = 'w-full h-full object-cover';
      thumb.appendChild(img);

      const hasSensitiveExif = item.inspection.gps.hasGps ||
        Boolean(item.inspection.hardware.model || item.inspection.hardware.make) ||
        item.inspection.totalTagsCount > 3;

      const dot = document.createElement('div');
      dot.className = `absolute top-1 right-1 w-2 h-2 rounded-full ${
        item.cleanedResult
          ? 'bg-emerald-400'
          : hasSensitiveExif
          ? 'bg-rose-500'
          : 'bg-slate-400'
      }`;
      thumb.appendChild(dot);

      // Magnify preview icon on hover
      const zoomOverlay = document.createElement('div');
      zoomOverlay.className = "absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity text-white text-xs";
      zoomOverlay.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" /></svg>`;
      thumb.appendChild(zoomOverlay);

      thumb.addEventListener('click', () => {
        activeIndex = idx;
        renderThumbnailStrip();
        renderActiveItem();
      });

      thumbnailStrip.appendChild(thumb);
    });
  }

  function renderActiveItem() {
    const item = queue[activeIndex];
    if (!item) return;

    activeFilename.textContent = item.file.name;
    activePreviewImg.src = item.cleanedResult ? item.cleanedResult.cleanedUrl : item.previewUrl;

    if (item.cleanedResult) {
      activeDimensions.textContent = `${item.cleanedResult.originalDimensions.width} × ${item.cleanedResult.originalDimensions.height} px`;
    } else if (item.inspection.exposure.dimensions) {
      activeDimensions.textContent = item.inspection.exposure.dimensions;
    } else {
      activeDimensions.textContent = `${(item.file.size / 1024).toFixed(1)} KB`;
    }

    if (item.cleanedResult) {
      cleanedStampBadge.classList.remove('hidden');
      cleanedStampBadge.classList.add('flex');
    } else {
      cleanedStampBadge.classList.add('hidden');
      cleanedStampBadge.classList.remove('flex');
    }

    // Determine if actual sensitive EXIF/GPS leaks exist
    const hasGps = Boolean(item.inspection.gps && item.inspection.gps.hasGps && item.inspection.gps.latitude !== null && item.inspection.gps.longitude !== null);
    const hasHardware = Boolean(item.inspection.hardware && (item.inspection.hardware.make || item.inspection.hardware.model || item.inspection.hardware.serialNumber || item.inspection.hardware.lensModel));
    const hasTimestamp = Boolean(item.inspection.exposure && (item.inspection.exposure.dateTimeOriginal || item.inspection.exposure.dateTimeDigitized));
    const hasActualLeaks = hasGps || hasHardware || hasTimestamp;

    // Update Before/After Inspector Values
    const unverifiedRiskHtml = `<span class="inline-flex items-center gap-1.5 text-amber-300 font-mono text-[10px]"><span class="px-1.5 py-0.2 rounded bg-amber-950/90 border border-amber-500/40 text-[9px] text-amber-400 font-semibold uppercase">Risk</span> Hidden / Raw Metadata Tags Present (Unverified Risk)</span>`;
    const leakAlertBadge = `<span class="px-1.5 py-0.2 rounded bg-rose-950 border border-rose-500/40 text-[9px] text-rose-400 font-bold uppercase tracking-wider flex-shrink-0">Red Leak Alert</span>`;

    if (hasGps && item.inspection.gps.latitude !== null && item.inspection.gps.longitude !== null) {
      const lat = item.inspection.gps.latitude.toFixed(4);
      const lng = item.inspection.gps.longitude.toFixed(4);
      const refLat = item.inspection.gps.latitudeRef || '';
      const refLng = item.inspection.gps.longitudeRef || '';
      compareBeforeGps.innerHTML = `
        <span class="inline-flex flex-wrap items-center gap-1.5 text-rose-300 font-semibold">
          ${leakAlertBadge}
          <span>${lat}° ${refLat}, ${lng}° ${refLng}</span>
        </span>
      `;
    } else {
      compareBeforeGps.innerHTML = unverifiedRiskHtml;
    }

    const deviceMakeModel = [item.inspection.hardware.make, item.inspection.hardware.model].filter(Boolean).join(' ');
    if (deviceMakeModel) {
      compareBeforeDevice.innerHTML = `
        <span class="inline-flex flex-wrap items-center gap-1.5 text-rose-300 font-semibold">
          ${leakAlertBadge}
          <span class="truncate max-w-[210px]">${deviceMakeModel}</span>
        </span>
      `;
    } else {
      compareBeforeDevice.innerHTML = unverifiedRiskHtml;
    }

    if (item.inspection.hardware.serialNumber) {
      compareBeforeSerial.innerHTML = `
        <span class="inline-flex flex-wrap items-center gap-1.5 text-rose-300 font-semibold">
          ${leakAlertBadge}
          <span class="truncate max-w-[210px]">${item.inspection.hardware.serialNumber}</span>
        </span>
      `;
    } else {
      compareBeforeSerial.innerHTML = unverifiedRiskHtml;
    }

    const captureTimestamp = item.inspection.exposure.dateTimeOriginal || item.inspection.exposure.dateTimeDigitized;
    if (captureTimestamp) {
      compareBeforeDate.innerHTML = `
        <span class="inline-flex flex-wrap items-center gap-1.5 text-rose-300 font-semibold">
          ${leakAlertBadge}
          <span class="truncate max-w-[210px]">${captureTimestamp}</span>
        </span>
      `;
    } else {
      compareBeforeDate.innerHTML = unverifiedRiskHtml;
    }

    if (item.cleanedResult) {
      // 100% Sanitized state
      threatBadgeContainer.className = "py-2.5 px-4 rounded-xl text-xs sm:text-sm font-bold border border-emerald-500/40 bg-emerald-950/40 text-emerald-300 flex items-center justify-center gap-2 text-center shadow-[0_0_15px_-3px_rgba(16,185,129,0.25)]";
      threatBadgeIcon.textContent = "🛡️";
      threatBadgeText.textContent = "100% Cleaned & Sanitized — Saved";
      btnCleanSingleText.innerHTML = `<span>✓</span><span>Photo Saved — Download Again</span>`;
      btnCleanSingle.className = "w-full py-3.5 sm:py-4 px-6 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 shadow-lg shadow-emerald-600/25 text-white font-bold text-sm sm:text-base tracking-wide backdrop-blur-md transition-all active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer";
      
      // Auto-open comparison when sanitized for visual trust
      if (!isComparisonOpen) {
        isComparisonOpen = true;
        comparisonContent.classList.remove('hidden');
        comparisonChevron.classList.add('rotate-180');
      }
    } else {
      // Unscrubbed image — Always flag that scrubbing is required to eliminate confusing clean claims on unscrubbed files
      threatBadgeContainer.className = "py-2.5 px-4 rounded-xl text-xs sm:text-sm font-bold border border-rose-500/50 bg-rose-950/50 text-rose-200 flex items-center justify-center gap-2 text-center shadow-[0_0_20px_-3px_rgba(244,63,94,0.35)]";
      threatBadgeIcon.textContent = "🔴";
      threatBadgeText.textContent = "Hidden Metadata Detected — Scrubbing Required";
      btnCleanSingleText.innerHTML = `<span>✨</span><span>Clean Metadata & Save Photo</span>`;
      btnCleanSingle.className = "w-full py-3.5 sm:py-4 px-6 rounded-2xl bg-gradient-to-r from-rose-600 to-red-600 hover:from-rose-500 hover:to-red-500 shadow-lg shadow-rose-600/30 text-white font-bold text-sm sm:text-base tracking-wide backdrop-blur-md transition-all active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer";
    }
  }

  function triggerDownload(url: string, filename: string) {
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }

  // 1-Click Clean & Download Action
  btnCleanSingle.addEventListener('click', async () => {
    const item = queue[activeIndex];
    if (!item || item.isCleaning) return;

    // If already cleaned, clicking triggers instant re-download
    if (item.cleanedResult) {
      triggerDownload(item.cleanedResult.cleanedUrl, item.cleanedResult.filename);
      return;
    }

    item.isCleaning = true;
    btnCleanSingle.disabled = true;
    btnCleanSingleText.innerHTML = `<span>⏳</span><span>Cleaning in RAM & Saving...</span>`;

    try {
      const res = await stripImageMetadata(item.file, item.file.name, { outputFormat: 'original' });
      item.cleanedResult = res;

      // 1-Click instant automatic download
      triggerDownload(res.cleanedUrl, res.filename);

      renderThumbnailStrip();
      renderActiveItem();
      updateZipButtonVisibility();
    } catch (err) {
      console.error("Stripping error:", err);
      alert("Failed to strip metadata: " + (err as Error).message);
    } finally {
      item.isCleaning = false;
      btnCleanSingle.disabled = false;
    }
  });

  // Clean All Batch Action
  btnCleanAll.addEventListener('click', async () => {
    if (queue.length === 0) return;

    btnCleanAll.disabled = true;
    const originalText = btnCleanAll.innerHTML;
    btnCleanAll.innerHTML = `<span>Processing...</span>`;

    for (let i = 0; i < queue.length; i++) {
      const item = queue[i];
      if (!item.cleanedResult) {
        try {
          const res = await stripImageMetadata(item.file, item.file.name, { outputFormat: 'original' });
          item.cleanedResult = res;
        } catch (err) {
          console.error("Batch strip error on item", i, err);
        }
      }
    }

    btnCleanAll.innerHTML = originalText;
    btnCleanAll.disabled = false;

    renderThumbnailStrip();
    renderActiveItem();
    updateZipButtonVisibility();
  });

  // Download All as ZIP
  btnDownloadZip.addEventListener('click', async () => {
    const cleanedItems = queue.filter(item => item.cleanedResult !== null);
    if (cleanedItems.length === 0) {
      alert("Please scrub your photos before downloading ZIP.");
      return;
    }

    btnDownloadZip.disabled = true;
    const origText = btnDownloadZip.innerHTML;
    btnDownloadZip.innerHTML = `<span>Bundling ZIP...</span>`;

    try {
      const zip = new JSZip();

      cleanedItems.forEach((item) => {
        if (item.cleanedResult) {
          zip.file(item.cleanedResult.filename, item.cleanedResult.cleanedBlob);
        }
      });

      const certText = `CleanPhoto Privacy Audit Report\nGenerated by: cleanphoto.fixeehub.com\nDate: ${new Date().toISOString()}\n\nAll images were stripped of 100% EXIF, IPTC, XMP, GPS coordinates, and camera serial numbers locally in client-side RAM.\n`;
      zip.file("PRIVACY_AUDIT_REPORT.txt", certText);

      const content = await zip.generateAsync({ type: 'blob' });
      const zipUrl = URL.createObjectURL(content);

      triggerDownload(zipUrl, `cleanphoto_vault_${Date.now()}.zip`);

      setTimeout(() => URL.revokeObjectURL(zipUrl), 5000);
    } catch (err) {
      console.error("ZIP creation failed:", err);
      alert("ZIP generation failed: " + (err as Error).message);
    } finally {
      btnDownloadZip.innerHTML = origText;
      btnDownloadZip.disabled = false;
    }
  });
</script>
