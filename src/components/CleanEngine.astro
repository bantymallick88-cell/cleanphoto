---
// CleanEngine.astro - Linear / Vercel Floating Scrubber Card
---

<div id="clean-engine" class="w-full max-w-3xl mx-auto px-4 py-2 scroll-mt-20">
  
  <!-- Scrubber Dropzone Card Container with Ambient Red Glow -->
  <div class="glass-panel rounded-2xl p-5 sm:p-6 transition-all border-rose-500/20 shadow-[0_0_50px_-15px_rgba(225,29,72,0.12)]">
    
    <!-- Card Header -->
    <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/[0.08]">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
        <h2 class="text-sm sm:text-base font-semibold text-white tracking-tight">EXIF Threat Scrubber</h2>
      </div>

      <div class="flex items-center gap-2">
        <button
          id="btn-load-sample"
          type="button"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.1] text-slate-300 hover:text-white text-xs font-mono transition-all active:scale-95"
        >
          <span class="text-rose-400">⚡</span>
          <span>Load Demo Sample</span>
        </button>

        <button
          id="btn-clear-all"
          type="button"
          class="hidden items-center gap-1 px-2.5 py-1 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.1] text-slate-400 hover:text-rose-400 text-xs font-mono transition-all"
          title="Reset files"
        >
          Reset
        </button>
      </div>
    </div>

    <!-- Dropzone Visual (High-Tech Security Scanner with Glowing Border) -->
    <div 
      id="drop-zone"
      class="border-2 border-dashed border-rose-500/30 hover:border-rose-500/70 bg-gradient-to-b from-rose-950/10 via-neutral-950/40 to-neutral-950/80 transition-all rounded-2xl p-8 sm:p-11 text-center cursor-pointer group relative overflow-hidden shadow-[0_0_35px_-10px_rgba(225,29,72,0.12)] hover:shadow-[0_0_45px_-5px_rgba(225,29,72,0.28)]"
    >
      <!-- Hidden File Input -->
      <input 
        type="file" 
        id="file-input" 
        multiple 
        accept="image/jpeg, image/jpg, image/png, image/webp, image/heic, image/heif, image/avif" 
        class="hidden" 
      />

      <div class="flex flex-col items-center justify-center pointer-events-none">
        <!-- High-Tech Security Scanner Aperture Icon -->
        <div class="w-14 h-14 mb-3.5 rounded-2xl bg-neutral-900/90 border border-neutral-800 flex items-center justify-center text-neutral-400 group-hover:text-rose-400 group-hover:border-rose-500/50 group-hover:scale-105 shadow-inner transition-all duration-300">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
          </svg>
        </div>

        <h3 class="text-base sm:text-lg font-bold text-white mb-1 tracking-tight">
          Drop your photo here to scan & scrub
        </h3>
        <p class="text-xs text-neutral-400 max-w-sm mx-auto mb-4 leading-normal">
          Instant in-memory privacy scan • Zero cloud upload
        </p>

        <!-- White Primary CTA Button -->
        <button
          type="button"
          id="btn-browse-trigger"
          class="pointer-events-auto inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white hover:bg-neutral-200 text-neutral-950 font-bold text-xs sm:text-sm transition-all shadow-md active:scale-95 mb-4 cursor-pointer"
        >
          <svg class="w-4 h-4 text-neutral-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
          </svg>
          <span>Browse Device</span>
        </button>

        <!-- Clear, Elegant Format Pill Badges: JPG · PNG · WEBP · HEIC · AVIF (Up to 100MB) -->
        <div class="flex flex-wrap items-center justify-center gap-1.5 text-[10px] sm:text-[11px] font-mono">
          <span class="bg-neutral-900/90 border border-neutral-800 px-2 py-0.5 rounded text-neutral-300 font-medium">JPG</span>
          <span class="bg-neutral-900/90 border border-neutral-800 px-2 py-0.5 rounded text-neutral-300 font-medium">PNG</span>
          <span class="bg-neutral-900/90 border border-neutral-800 px-2 py-0.5 rounded text-neutral-300 font-medium">WEBP</span>
          <span class="bg-neutral-900/90 border border-neutral-800 px-2 py-0.5 rounded text-neutral-300 font-medium">HEIC</span>
          <span class="bg-neutral-900/90 border border-neutral-800 px-2 py-0.5 rounded text-neutral-300 font-medium">AVIF</span>
          <span class="text-neutral-500 ml-1">(Up to 100MB)</span>
        </div>
      </div>
    </div>

    <!-- Loading State Indicator -->
    <div id="processing-loader" class="hidden my-4 p-4 rounded-xl bg-neutral-900/40 border border-neutral-800 text-center">
      <div class="inline-flex items-center justify-center w-8 h-8 rounded-full border-2 border-rose-500 border-t-transparent animate-spin mb-2"></div>
      <h4 id="loader-status-text" class="text-xs font-semibold text-white">Inspecting EXIF Metadata...</h4>
      <p class="text-[10px] text-neutral-400 mt-0.5 font-mono">Parsing memory buffers locally</p>
    </div>

    <!-- Active Work Area (Queue & Inspection) -->
    <div id="workspace-container" class="hidden mt-6 space-y-4">
      
      <!-- Toolbar: Queue count + Clean Batch Actions -->
      <div class="p-3 rounded-xl bg-neutral-900/40 border border-neutral-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold text-white">Queue:</span>
          <span id="queue-count-badge" class="px-2 py-0.5 rounded bg-neutral-800 text-neutral-300 text-[11px] font-mono">
            0 files
          </span>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button
            id="btn-clean-all"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white hover:bg-neutral-200 text-neutral-950 font-semibold text-xs transition-all active:scale-95 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 text-neutral-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Scrub All Files</span>
          </button>

          <button
            id="btn-download-zip"
            type="button"
            class="hidden inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-white font-semibold text-xs transition-all active:scale-95 cursor-pointer border border-neutral-700"
          >
            <svg class="w-3.5 h-3.5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
            </svg>
            <span>Download All (.ZIP)</span>
          </button>
        </div>
      </div>

      <!-- Thumbnails Strip -->
      <div id="thumbnail-strip" class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-thin">
        <!-- Rendered dynamically -->
      </div>

      <!-- Selected Image Inspector Details -->
      <div id="inspector-card" class="grid grid-cols-1 md:grid-cols-12 gap-4 pt-1">
        
        <!-- Left: Preview & 1-Click Action -->
        <div class="md:col-span-5 space-y-3">
          <div class="p-3.5 rounded-xl bg-neutral-900/40 border border-neutral-800">
            <div class="flex items-center justify-between gap-2 mb-2">
              <span id="active-filename" class="text-xs font-semibold text-white truncate max-w-[170px]">
                photo.jpg
              </span>
              <span id="active-dimensions" class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-neutral-950 text-neutral-400 border border-neutral-800 flex-shrink-0">
                -- × --
              </span>
            </div>

            <!-- Preview Box -->
            <div class="relative rounded-lg overflow-hidden bg-neutral-950 border border-neutral-900 flex items-center justify-center min-h-[160px] max-h-[220px]">
              <img 
                id="active-preview-img" 
                src="" 
                alt="Photo preview" 
                class="max-w-full max-h-[210px] object-contain rounded transition-transform duration-300" 
              />

              <!-- Cleaned Stamp Badge -->
              <div id="cleaned-stamp-badge" class="hidden absolute top-2 right-2 px-2 py-0.5 rounded bg-emerald-950/90 border border-emerald-500/40 text-emerald-400 text-[10px] font-mono font-semibold items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>SANITIZED</span>
              </div>
            </div>

            <!-- Real-Time EXIF Threat & Detection Badge Box -->
            <div class="mt-3.5 p-3 rounded-xl bg-neutral-950/90 border border-neutral-800/80 space-y-2.5">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[10px] font-bold text-neutral-400 uppercase tracking-wider font-mono">Privacy Threat Status</span>
                <span id="threat-score-number" class="text-xs font-mono font-bold text-rose-400">Score: 85/100</span>
              </div>
              <div class="w-full bg-neutral-900 h-1.5 rounded-full overflow-hidden">
                <div id="threat-score-bar" class="h-full rounded-full bg-gradient-to-r from-amber-400 via-rose-500 to-red-500 transition-all duration-300" style="width: 85%"></div>
              </div>
              
              <!-- Real-Time Detection Badge (Red Threat vs Safe vs Sanitized) -->
              <div id="threat-badge-container" class="p-3 rounded-xl text-xs font-bold border transition-all flex items-center justify-center gap-2 text-center">
                <span id="threat-badge-icon" class="text-sm flex-shrink-0">🔴</span>
                <span id="threat-badge-text" class="tracking-wide uppercase">HIGH PRIVACY RISK DETECTED</span>
              </div>
            </div>

            <!-- Single Primary Action Button: Large, Vibrant, Glowing Crimson-to-Rose Gradient -->
            <div class="mt-3.5">
              <button
                id="btn-clean-single"
                type="button"
                class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-rose-600 to-red-600 hover:from-rose-500 hover:to-red-500 shadow-lg shadow-rose-600/30 text-white font-bold text-xs sm:text-sm tracking-wide transition-all active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer"
              >
                <span id="btn-clean-single-text" class="flex items-center justify-center gap-2">
                  <span>🛡️</span>
                  <span>SCRUB PRIVACY LEAKS & SAVE PHOTO</span>
                </span>
              </button>
            </div>
          </div>
        </div>

        <!-- Right: Sleek Metadata Inspection Cards -->
        <div class="md:col-span-7 space-y-3">
          <div class="p-3.5 rounded-xl bg-neutral-900/40 border border-neutral-800">
            <!-- Sleek Tabs Bar (GPS, Hardware, Timestamp) -->
            <div class="flex items-center gap-1.5 border-b border-neutral-800 pb-2 mb-3 overflow-x-auto scrollbar-none">
              <button class="tab-btn active px-3 py-1 rounded-lg text-xs font-medium text-white bg-neutral-800 transition-colors flex items-center gap-1.5 flex-shrink-0 cursor-pointer" data-tab="gps">
                <span>📍 GPS Location</span>
                <span id="tab-gps-count" class="px-1.5 py-0.2 rounded-full bg-rose-950 text-rose-400 text-[10px] font-mono">!</span>
              </button>
              <button class="tab-btn px-3 py-1 rounded-lg text-xs font-medium text-neutral-400 hover:text-white transition-colors flex items-center gap-1.5 flex-shrink-0 cursor-pointer" data-tab="hardware">
                <span>📷 Camera Hardware</span>
              </button>
              <button class="tab-btn px-3 py-1 rounded-lg text-xs font-medium text-neutral-400 hover:text-white transition-colors flex items-center gap-1.5 flex-shrink-0 cursor-pointer" data-tab="exposure">
                <span>⏱️ Timestamp & Details</span>
              </button>
            </div>

            <!-- Tab 1: GPS Location -->
            <div id="tab-content-gps" class="tab-pane space-y-2.5">
              <div id="gps-alert-box" class="p-2.5 rounded-lg bg-rose-950/30 border border-rose-500/30 text-rose-200 text-xs flex items-start gap-2">
                <span class="text-sm">⚠️</span>
                <div>
                  <strong class="font-semibold text-white block text-[11px]">Physical Location Leak Hazard</strong>
                  <p id="gps-alert-text" class="text-[10px] text-rose-300 leading-tight">
                    Pinpointed to precise GPS coordinates. Uploading this image online reveals exact real-world location.
                  </p>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-2 text-left">
                <div class="p-2.5 rounded-lg bg-neutral-950 border border-neutral-900">
                  <span class="text-[10px] text-neutral-500 block font-mono">Latitude</span>
                  <span id="gps-val-lat" class="text-xs font-semibold text-white font-mono break-all">--</span>
                </div>
                <div class="p-2.5 rounded-lg bg-neutral-950 border border-neutral-900">
                  <span class="text-[10px] text-neutral-500 block font-mono">Longitude</span>
                  <span id="gps-val-lng" class="text-xs font-semibold text-white font-mono break-all">--</span>
                </div>
                <div class="p-2.5 rounded-lg bg-neutral-950 border border-neutral-900 col-span-2">
                  <span class="text-[10px] text-neutral-500 block font-mono">DMS Representation</span>
                  <span id="gps-val-dms" class="text-xs font-mono text-neutral-300 break-all">--</span>
                </div>
              </div>

              <div id="gps-map-links-container" class="flex flex-wrap items-center gap-2 pt-1 text-xs">
                <a id="link-google-maps" href="#" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 rounded bg-neutral-900 hover:bg-neutral-800 border border-neutral-800 text-neutral-300 font-mono text-[11px] transition-colors">View on Google Maps</a>
                <a id="link-osm" href="#" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 rounded bg-neutral-900 hover:bg-neutral-800 border border-neutral-800 text-neutral-300 font-mono text-[11px] transition-colors">OpenStreetMap</a>
              </div>

              <div id="gps-empty-state" class="hidden p-4 rounded-lg bg-neutral-950 border border-neutral-900 text-center">
                <span class="text-xs text-neutral-400">Zero GPS location tags detected in this image.</span>
              </div>
            </div>

            <!-- Tab 2: Camera Hardware -->
            <div id="tab-content-hardware" class="tab-pane hidden space-y-2">
              <div class="grid grid-cols-2 gap-2 text-left">
                <div class="p-2.5 rounded-lg bg-neutral-950 border border-neutral-900">
                  <span class="text-[10px] text-neutral-500 block">Manufacturer</span>
                  <span id="hw-make" class="text-xs font-semibold text-white font-mono truncate block">--</span>
                </div>
                <div class="p-2.5 rounded-lg bg-neutral-950 border border-neutral-900">
                  <span class="text-[10px] text-neutral-500 block">Camera / Phone Model</span>
                  <span id="hw-model" class="text-xs font-semibold text-white font-mono truncate block">--</span>
                </div>
                <div class="p-2.5 rounded-lg bg-neutral-950 border border-neutral-900 col-span-2">
                  <span class="text-[10px] text-neutral-500 block">Lens Specification</span>
                  <span id="hw-lens" class="text-xs text-neutral-300 font-mono break-all">--</span>
                </div>
                <div class="p-2.5 rounded-lg bg-neutral-950 border border-neutral-900">
                  <span class="text-[10px] text-neutral-500 block">Firmware / OS</span>
                  <span id="hw-software" class="text-xs text-neutral-300 font-mono truncate block">--</span>
                </div>
                <div class="p-2.5 rounded-lg bg-neutral-950 border border-neutral-900">
                  <span class="text-[10px] text-rose-400 block font-semibold">Body Serial Number</span>
                  <span id="hw-serial" class="text-xs font-mono font-bold text-rose-300 truncate block">--</span>
                </div>
              </div>
            </div>

            <!-- Tab 3: Capture Timestamp & Exposure -->
            <div id="tab-content-exposure" class="tab-pane hidden space-y-2">
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-left">
                <div class="p-2.5 rounded-lg bg-neutral-950 border border-neutral-900 col-span-2 sm:col-span-3">
                  <span class="text-[10px] text-neutral-500 block">Original Date & Time Recorded</span>
                  <span id="exp-date" class="text-xs font-mono text-white font-medium">--</span>
                </div>
                <div class="p-2.5 rounded-lg bg-neutral-950 border border-neutral-900">
                  <span class="text-[10px] text-neutral-500 block">ISO Rating</span>
                  <span id="exp-iso" class="text-xs font-mono text-white">--</span>
                </div>
                <div class="p-2.5 rounded-lg bg-neutral-950 border border-neutral-900">
                  <span class="text-[10px] text-neutral-500 block">Aperture</span>
                  <span id="exp-aperture" class="text-xs font-mono text-white">--</span>
                </div>
                <div class="p-2.5 rounded-lg bg-neutral-950 border border-neutral-900">
                  <span class="text-[10px] text-neutral-500 block">Shutter Speed</span>
                  <span id="exp-shutter" class="text-xs font-mono text-white">--</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>

  </div>

</div>

<script>
  import JSZip from 'jszip';
  import { inspectImageFile, type ImageMetadataInspection } from '../utils/exifParser';
  import { stripImageMetadata, type CleanResult } from '../utils/imageCleaner';
  import { isHeicFile, convertHeicToJpegBlob } from '../utils/heicHelper';
  import { createDemoPhotoFile } from '../utils/sampleDemoPhoto';

  interface QueuedImage {
    id: string;
    file: File;
    previewUrl: string;
    inspection: ImageMetadataInspection;
    cleanedResult: CleanResult | null;
    isCleaning: boolean;
  }

  let queue: QueuedImage[] = [];
  let activeIndex: number = 0;

  const dropZone = document.getElementById('drop-zone') as HTMLDivElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const btnBrowseTrigger = document.getElementById('btn-browse-trigger') as HTMLButtonElement;
  const btnLoadSample = document.getElementById('btn-load-sample') as HTMLButtonElement;
  const btnClearAll = document.getElementById('btn-clear-all') as HTMLButtonElement;
  const processingLoader = document.getElementById('processing-loader') as HTMLDivElement;
  const loaderStatusText = document.getElementById('loader-status-text') as HTMLHeadingElement;
  const workspaceContainer = document.getElementById('workspace-container') as HTMLDivElement;
  const queueCountBadge = document.getElementById('queue-count-badge') as HTMLSpanElement;
  const thumbnailStrip = document.getElementById('thumbnail-strip') as HTMLDivElement;
  const btnCleanAll = document.getElementById('btn-clean-all') as HTMLButtonElement;
  const btnDownloadZip = document.getElementById('btn-download-zip') as HTMLButtonElement;

  // Active Item Elements
  const activeFilename = document.getElementById('active-filename') as HTMLSpanElement;
  const activeDimensions = document.getElementById('active-dimensions') as HTMLSpanElement;
  const activePreviewImg = document.getElementById('active-preview-img') as HTMLImageElement;
  const cleanedStampBadge = document.getElementById('cleaned-stamp-badge') as HTMLDivElement;
  const threatScoreNumber = document.getElementById('threat-score-number') as HTMLSpanElement;
  const threatScoreBar = document.getElementById('threat-score-bar') as HTMLDivElement;
  const threatBadgeContainer = document.getElementById('threat-badge-container') as HTMLDivElement;
  const threatBadgeIcon = document.getElementById('threat-badge-icon') as HTMLSpanElement;
  const threatBadgeText = document.getElementById('threat-badge-text') as HTMLSpanElement;
  const btnCleanSingle = document.getElementById('btn-clean-single') as HTMLButtonElement;
  const btnCleanSingleText = document.getElementById('btn-clean-single-text') as HTMLSpanElement;

  // Tabs
  const tabButtons = document.querySelectorAll('.tab-btn');
  const tabPanes = document.querySelectorAll('.tab-pane');
  const tabGpsCount = document.getElementById('tab-gps-count') as HTMLSpanElement;

  // GPS fields
  const gpsAlertBox = document.getElementById('gps-alert-box') as HTMLDivElement;
  const gpsAlertText = document.getElementById('gps-alert-text') as HTMLParagraphElement;
  const gpsValLat = document.getElementById('gps-val-lat') as HTMLSpanElement;
  const gpsValLng = document.getElementById('gps-val-lng') as HTMLSpanElement;
  const gpsValDms = document.getElementById('gps-val-dms') as HTMLSpanElement;
  const gpsMapLinksContainer = document.getElementById('gps-map-links-container') as HTMLDivElement;
  const linkGoogleMaps = document.getElementById('link-google-maps') as HTMLAnchorElement;
  const linkOsm = document.getElementById('link-osm') as HTMLAnchorElement;
  const gpsEmptyState = document.getElementById('gps-empty-state') as HTMLDivElement;

  // Hardware fields
  const hwMake = document.getElementById('hw-make') as HTMLSpanElement;
  const hwModel = document.getElementById('hw-model') as HTMLSpanElement;
  const hwLens = document.getElementById('hw-lens') as HTMLSpanElement;
  const hwSoftware = document.getElementById('hw-software') as HTMLSpanElement;
  const hwSerial = document.getElementById('hw-serial') as HTMLSpanElement;

  // Exposure fields
  const expDate = document.getElementById('exp-date') as HTMLSpanElement;
  const expIso = document.getElementById('exp-iso') as HTMLSpanElement;
  const expAperture = document.getElementById('exp-aperture') as HTMLSpanElement;
  const expShutter = document.getElementById('exp-shutter') as HTMLSpanElement;

  // Drag & Drop
  ['dragenter', 'dragover'].forEach(name => {
    dropZone.addEventListener(name, (e) => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.add('border-rose-500', 'bg-neutral-900/60');
    });
  });

  ['dragleave', 'drop'].forEach(name => {
    dropZone.addEventListener(name, (e) => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.remove('border-rose-500', 'bg-neutral-900/60');
    });
  });

  dropZone.addEventListener('drop', (e: DragEvent) => {
    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
      handleFiles(Array.from(e.dataTransfer.files));
    }
  });

  dropZone.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.id !== 'btn-browse-trigger' && !target.closest('#btn-browse-trigger')) {
      fileInput.click();
    }
  });

  if (btnBrowseTrigger) {
    btnBrowseTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.click();
    });
  }

  fileInput.addEventListener('change', () => {
    if (fileInput.files && fileInput.files.length > 0) {
      handleFiles(Array.from(fileInput.files));
      fileInput.value = '';
    }
  });

  btnLoadSample.addEventListener('click', async () => {
    const demoFile = createDemoPhotoFile();
    await handleFiles([demoFile]);
  });

  btnClearAll.addEventListener('click', () => {
    queue.forEach(item => {
      URL.revokeObjectURL(item.previewUrl);
      if (item.cleanedResult) URL.revokeObjectURL(item.cleanedResult.cleanedUrl);
    });
    queue = [];
    activeIndex = 0;
    updateWorkspaceVisibility();
  });

  // Tab switching
  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tabTarget = btn.getAttribute('data-tab');
      tabButtons.forEach(b => {
        b.classList.remove('active', 'bg-neutral-800', 'text-white');
        b.classList.add('text-neutral-400');
      });
      btn.classList.add('active', 'bg-neutral-800', 'text-white');
      btn.classList.remove('text-neutral-400');

      tabPanes.forEach(pane => {
        if (pane.id === `tab-content-${tabTarget}`) {
          pane.classList.remove('hidden');
        } else {
          pane.classList.add('hidden');
        }
      });
    });
  });

  async function handleFiles(files: File[]) {
    const validFiles = files.filter(f => f.type.startsWith('image/') || f.name.match(/\.(jpg|jpeg|png|webp|heic|heif|avif|tiff)$/i));
    if (validFiles.length === 0) return;

    processingLoader.classList.remove('hidden');
    loaderStatusText.textContent = `Analyzing ${validFiles.length} photo(s)...`;

    try {
      for (const file of validFiles) {
        let previewUrl: string;
        if (isHeicFile(file)) {
          try {
            const convertedBlob = await convertHeicToJpegBlob(file);
            previewUrl = URL.createObjectURL(convertedBlob);
          } catch {
            previewUrl = URL.createObjectURL(file);
          }
        } else {
          previewUrl = URL.createObjectURL(file);
        }

        const inspection = await inspectImageFile(file);

        queue.push({
          id: Math.random().toString(36).substring(2, 9),
          file,
          previewUrl,
          inspection,
          cleanedResult: null,
          isCleaning: false
        });
      }

      activeIndex = queue.length - validFiles.length;
      if (activeIndex < 0) activeIndex = 0;

      updateWorkspaceVisibility();
      renderThumbnailStrip();
      renderActiveItem();
    } finally {
      processingLoader.classList.add('hidden');
    }
  }

  function updateWorkspaceVisibility() {
    if (queue.length > 0) {
      workspaceContainer.classList.remove('hidden');
      btnClearAll.classList.remove('hidden');
      btnClearAll.classList.add('inline-flex');
      queueCountBadge.textContent = `${queue.length} photo${queue.length > 1 ? 's' : ''}`;
    } else {
      workspaceContainer.classList.add('hidden');
      btnClearAll.classList.add('hidden');
      btnClearAll.classList.remove('inline-flex');
    }
    updateZipButtonVisibility();
  }

  function updateZipButtonVisibility() {
    const hasAnyCleaned = queue.some(item => item.cleanedResult !== null);
    if (hasAnyCleaned) {
      btnDownloadZip.classList.remove('hidden');
      btnDownloadZip.classList.add('inline-flex');
    } else {
      btnDownloadZip.classList.add('hidden');
      btnDownloadZip.classList.remove('inline-flex');
    }
  }

  function renderThumbnailStrip() {
    thumbnailStrip.innerHTML = '';
    queue.forEach((item, idx) => {
      const thumb = document.createElement('div');
      thumb.className = `relative flex-shrink-0 w-14 h-14 rounded-lg overflow-hidden cursor-pointer border transition-all ${
        idx === activeIndex
          ? 'border-white shadow-sm scale-105'
          : 'border-neutral-800 opacity-60 hover:opacity-100'
      }`;

      const img = document.createElement('img');
      img.src = item.previewUrl;
      img.alt = item.file.name;
      img.className = 'w-full h-full object-cover';
      thumb.appendChild(img);

      const hasSensitiveExif = item.inspection.gps.hasGps ||
        Boolean(item.inspection.hardware.model || item.inspection.hardware.make) ||
        item.inspection.totalTagsCount > 3;

      const dot = document.createElement('div');
      dot.className = `absolute top-1 right-1 w-2 h-2 rounded-full ${
        item.cleanedResult
          ? 'bg-emerald-400'
          : hasSensitiveExif
          ? 'bg-rose-500'
          : 'bg-slate-400'
      }`;
      thumb.appendChild(dot);

      thumb.addEventListener('click', () => {
        activeIndex = idx;
        renderThumbnailStrip();
        renderActiveItem();
      });

      thumbnailStrip.appendChild(thumb);
    });
  }

  function renderActiveItem() {
    const item = queue[activeIndex];
    if (!item) return;

    activeFilename.textContent = item.file.name;
    activePreviewImg.src = item.cleanedResult ? item.cleanedResult.cleanedUrl : item.previewUrl;

    if (item.cleanedResult) {
      activeDimensions.textContent = `${item.cleanedResult.originalDimensions.width} × ${item.cleanedResult.originalDimensions.height} px`;
    } else if (item.inspection.exposure.dimensions) {
      activeDimensions.textContent = item.inspection.exposure.dimensions;
    } else {
      activeDimensions.textContent = `${(item.file.size / 1024).toFixed(1)} KB`;
    }

    if (item.cleanedResult) {
      cleanedStampBadge.classList.remove('hidden');
      cleanedStampBadge.classList.add('flex');
    } else {
      cleanedStampBadge.classList.add('hidden');
      cleanedStampBadge.classList.remove('flex');
    }

    // Determine if sensitive EXIF/GPS exists
    const hasSensitiveExif = item.inspection.gps.hasGps ||
      Boolean(item.inspection.hardware.model || item.inspection.hardware.make || item.inspection.hardware.serialNumber) ||
      Boolean(item.inspection.exposure.dateTimeOriginal) ||
      item.inspection.totalTagsCount > 3;

    if (item.cleanedResult) {
      // 100% Sanitized state
      threatScoreNumber.textContent = "Safe: 0/100";
      threatScoreNumber.className = "text-xs font-mono font-bold text-emerald-400";
      threatScoreBar.style.width = "0%";
      threatScoreBar.className = "h-full rounded-full bg-emerald-500";
      threatBadgeContainer.className = "p-3 rounded-xl text-xs font-bold border border-emerald-500/40 bg-emerald-950/40 text-emerald-300 flex items-center justify-center gap-2 text-center shadow-[0_0_15px_-3px_rgba(16,185,129,0.25)]";
      threatBadgeIcon.textContent = "🛡️";
      threatBadgeText.textContent = "100% SANITIZED & SAFE PHOTO";
      btnCleanSingleText.innerHTML = `<span>✓</span><span>PHOTO SAVED — DOWNLOAD AGAIN</span>`;
      btnCleanSingle.className = "w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 shadow-lg shadow-emerald-600/25 text-white font-bold text-xs sm:text-sm tracking-wide transition-all active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer";
    } else if (hasSensitiveExif) {
      // High Contrast Red Alert
      const score = Math.max(50, item.inspection.threat.score);
      threatScoreNumber.textContent = `Score: ${score}/100`;
      threatScoreNumber.className = "text-xs font-mono font-bold text-rose-400";
      threatScoreBar.style.width = `${score}%`;
      threatScoreBar.className = "h-full rounded-full bg-gradient-to-r from-amber-400 via-rose-500 to-red-500";
      threatBadgeContainer.className = "p-3 rounded-xl text-xs font-bold border border-rose-500/50 bg-rose-950/50 text-rose-200 flex items-center justify-center gap-2 text-center shadow-[0_0_20px_-3px_rgba(244,63,94,0.35)]";
      threatBadgeIcon.textContent = "🔴";
      threatBadgeText.textContent = "HIGH PRIVACY RISK DETECTED";
      btnCleanSingleText.innerHTML = `<span>🛡️</span><span>SCRUB PRIVACY LEAKS & SAVE PHOTO</span>`;
      btnCleanSingle.className = "w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-rose-600 to-red-600 hover:from-rose-500 hover:to-red-500 shadow-lg shadow-rose-600/30 text-white font-bold text-xs sm:text-sm tracking-wide transition-all active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer";
    } else {
      // 100% Safe Photo
      threatScoreNumber.textContent = "Clean: 0/100";
      threatScoreNumber.className = "text-xs font-mono font-bold text-emerald-400";
      threatScoreBar.style.width = "0%";
      threatScoreBar.className = "h-full rounded-full bg-emerald-500/50";
      threatBadgeContainer.className = "p-3 rounded-xl text-xs font-bold border border-emerald-500/40 bg-emerald-950/30 text-emerald-300 flex items-center justify-center gap-2 text-center shadow-[0_0_15px_-3px_rgba(16,185,129,0.2)]";
      threatBadgeIcon.textContent = "🟢";
      threatBadgeText.textContent = "100% SAFE PHOTO";
      btnCleanSingleText.innerHTML = `<span>🛡️</span><span>SCRUB PRIVACY LEAKS & SAVE PHOTO</span>`;
      btnCleanSingle.className = "w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-rose-600 to-red-600 hover:from-rose-500 hover:to-red-500 shadow-lg shadow-rose-600/30 text-white font-bold text-xs sm:text-sm tracking-wide transition-all active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer";
    }

    // Tab 1: GPS
    const gps = item.inspection.gps;
    if (item.cleanedResult) {
      gpsAlertBox.classList.add('hidden');
      gpsEmptyState.classList.remove('hidden');
      gpsMapLinksContainer.classList.add('hidden');
      gpsValLat.textContent = "Stripped";
      gpsValLng.textContent = "Stripped";
      gpsValDms.textContent = "None";
      tabGpsCount.textContent = "0";
      tabGpsCount.className = "px-1.5 py-0.2 rounded-full bg-neutral-800 text-neutral-400 text-[10px] font-mono";
    } else if (gps.hasGps && gps.latitude !== null && gps.longitude !== null) {
      gpsAlertBox.classList.remove('hidden');
      gpsEmptyState.classList.add('hidden');
      gpsMapLinksContainer.classList.remove('hidden');
      gpsValLat.textContent = `${gps.latitude.toFixed(6)}° ${gps.latitudeRef || ''}`;
      gpsValLng.textContent = `${gps.longitude.toFixed(6)}° ${gps.longitudeRef || ''}`;
      gpsValDms.textContent = `${gps.dmsLat || ''}, ${gps.dmsLng || ''}`;
      linkGoogleMaps.href = gps.googleMapsUrl || '#';
      linkOsm.href = gps.osmUrl || '#';
      tabGpsCount.textContent = "!";
      tabGpsCount.className = "px-1.5 py-0.2 rounded-full bg-rose-950 text-rose-400 text-[10px] font-mono";
    } else {
      gpsAlertBox.classList.add('hidden');
      gpsEmptyState.classList.remove('hidden');
      gpsMapLinksContainer.classList.add('hidden');
      gpsValLat.textContent = "None detected";
      gpsValLng.textContent = "None detected";
      gpsValDms.textContent = "None";
      tabGpsCount.textContent = "0";
      tabGpsCount.className = "px-1.5 py-0.2 rounded-full bg-neutral-800 text-neutral-400 text-[10px] font-mono";
    }

    // Tab 2: Hardware
    const hw = item.cleanedResult ? {} : item.inspection.hardware;
    hwMake.textContent = hw.make || 'None';
    hwModel.textContent = hw.model || 'None';
    hwLens.textContent = hw.lensModel || 'None detected';
    hwSoftware.textContent = hw.software || 'None';
    hwSerial.textContent = hw.serialNumber || 'None';

    // Tab 3: Exposure & Timestamp
    const exp = item.cleanedResult ? {} : item.inspection.exposure;
    expDate.textContent = exp.dateTimeOriginal || 'None';
    expIso.textContent = exp.iso || 'None';
    expAperture.textContent = exp.fNumber || 'None';
    expShutter.textContent = exp.shutterSpeed || 'None';
  }

  function triggerDownload(url: string, filename: string) {
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }

  // 1-Click Clean & Download Action
  btnCleanSingle.addEventListener('click', async () => {
    const item = queue[activeIndex];
    if (!item || item.isCleaning) return;

    // If already cleaned, clicking triggers instant re-download
    if (item.cleanedResult) {
      triggerDownload(item.cleanedResult.cleanedUrl, item.cleanedResult.filename);
      return;
    }

    item.isCleaning = true;
    btnCleanSingle.disabled = true;
    btnCleanSingleText.innerHTML = `<span>⏳</span><span>SCRUBBING IN RAM & SAVING...</span>`;

    try {
      const res = await stripImageMetadata(item.file, item.file.name, { outputFormat: 'original' });
      item.cleanedResult = res;

      // 1-Click instant automatic download
      triggerDownload(res.cleanedUrl, res.filename);

      renderThumbnailStrip();
      renderActiveItem();
      updateZipButtonVisibility();
    } catch (err) {
      console.error("Stripping error:", err);
      alert("Failed to strip metadata: " + (err as Error).message);
    } finally {
      item.isCleaning = false;
      btnCleanSingle.disabled = false;
    }
  });

  // Clean All Batch Action
  btnCleanAll.addEventListener('click', async () => {
    if (queue.length === 0) return;

    btnCleanAll.disabled = true;
    const originalText = btnCleanAll.innerHTML;
    btnCleanAll.innerHTML = `<span>Processing...</span>`;

    for (let i = 0; i < queue.length; i++) {
      const item = queue[i];
      if (!item.cleanedResult) {
        try {
          const res = await stripImageMetadata(item.file, item.file.name, { outputFormat: 'original' });
          item.cleanedResult = res;
        } catch (err) {
          console.error("Batch strip error on item", i, err);
        }
      }
    }

    btnCleanAll.innerHTML = originalText;
    btnCleanAll.disabled = false;

    renderThumbnailStrip();
    renderActiveItem();
    updateZipButtonVisibility();
  });

  // Download All as ZIP
  btnDownloadZip.addEventListener('click', async () => {
    const cleanedItems = queue.filter(item => item.cleanedResult !== null);
    if (cleanedItems.length === 0) {
      alert("Please scrub your photos before downloading ZIP.");
      return;
    }

    btnDownloadZip.disabled = true;
    const origText = btnDownloadZip.innerHTML;
    btnDownloadZip.innerHTML = `<span>Bundling ZIP...</span>`;

    try {
      const zip = new JSZip();

      cleanedItems.forEach((item) => {
        if (item.cleanedResult) {
          zip.file(item.cleanedResult.filename, item.cleanedResult.cleanedBlob);
        }
      });

      const certText = `CleanPhoto Privacy Audit Report\nGenerated by: cleanphoto.fixeehub.com\nDate: ${new Date().toISOString()}\n\nAll images were stripped of 100% EXIF, IPTC, XMP, GPS coordinates, and camera serial numbers locally in client-side RAM.\n`;
      zip.file("PRIVACY_AUDIT_REPORT.txt", certText);

      const content = await zip.generateAsync({ type: 'blob' });
      const zipUrl = URL.createObjectURL(content);

      triggerDownload(zipUrl, `cleanphoto_vault_${Date.now()}.zip`);

      setTimeout(() => URL.revokeObjectURL(zipUrl), 5000);
    } catch (err) {
      console.error("ZIP creation failed:", err);
      alert("ZIP generation failed: " + (err as Error).message);
    } finally {
      btnDownloadZip.innerHTML = origText;
      btnDownloadZip.disabled = false;
    }
  });
</script>
