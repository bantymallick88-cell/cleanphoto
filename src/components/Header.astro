---
// Header.astro - CleanPhoto x FixeeHub
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#0c0507]/90 backdrop-blur-md border-b border-red-500/20">
  <div class="flex items-center justify-between w-full max-w-4xl mx-auto px-4 py-3">
    <!-- Responsive Logo Container (flex-shrink-0, no clip on 320px+) -->
    <a href="/" class="flex items-center gap-2 sm:gap-2.5 flex-shrink-0 group transition-all duration-200">
      <!-- Shield + Aperture Icon -->
      <div class="relative flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-red-950/50 border border-red-500/40 text-red-500 shadow-[0_0_12px_rgba(239,68,68,0.4)] group-hover:border-red-400 transition-all duration-300">
        <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L4 5v6.5C4 16.5 7.4 20.8 12 22c4.6-1.2 8-5.5 8-10.5V5l-8-3z" class="stroke-red-500" />
          <circle cx="12" cy="11.5" r="4.5" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2 1.5" />
          <circle cx="12" cy="11.5" r="1.2" fill="currentColor" />
        </svg>
        <span class="absolute -top-1 -right-1 flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-red-600"></span>
        </span>
      </div>

      <!-- Typography -->
      <div class="flex-shrink-0 flex items-center gap-1 sm:gap-1.5">
        <span class="text-sm sm:text-base font-extrabold tracking-wider text-white group-hover:text-red-400 transition-colors">
          CLEANPHOTO
        </span>
        <span class="text-[10px] sm:text-xs font-semibold px-1.5 py-0.5 rounded bg-red-950/80 border border-red-500/30 text-red-300 tracking-tight">
          x FIXEEHUB
        </span>
      </div>
    </a>

    <!-- Header Right Navigation & Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- In-Browser RAM Pill -->
      <div class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-red-950/60 border border-red-500/30 text-red-300 text-xs font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-red-500 shadow-[0_0_8px_#EF4444] animate-pulse"></span>
        <span>Zero-Server RAM</span>
      </div>

      <!-- Privacy Story Anchor Link -->
      <a 
        href="#why-clean" 
        class="text-xs sm:text-sm text-gray-300 hover:text-white px-2 py-1 rounded-lg hover:bg-red-950/40 transition-all font-medium"
      >
        Privacy Story
      </a>

      <!-- Contact Email Button -->
      <a 
        href="mailto:contactfixeehub@gmail.com"
        class="inline-flex items-center gap-1 text-xs sm:text-sm font-semibold px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-lg bg-red-600/30 hover:bg-red-600/50 border border-red-500/40 text-red-200 hover:text-white transition-all active:scale-95"
        title="Contact CleanPhoto team"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span class="hidden xs:inline">Contact</span>
      </a>
    </div>
  </div>
</header>
