---
// Header.astro - Clean SaaS Glassmorphic Header
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-[#070709]/80 border-b border-white/[0.08] transition-colors">
  <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <!-- Left: Clean Logo Branding with Subtle Shield Icon -->
    <a href="/" class="flex items-center gap-2 sm:gap-2.5 flex-shrink-0 group">
      <!-- Minimalist Security Aperture / Shield Icon -->
      <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-white/[0.04] border border-white/[0.1] flex items-center justify-center text-slate-200 group-hover:border-rose-500/40 group-hover:text-rose-400 transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L4 5v6.5C4 16.5 7.4 20.8 12 22c4.6-1.2 8-5.5 8-10.5V5l-8-3z" />
          <circle cx="12" cy="11.5" r="4.5" stroke-dasharray="2 1.5" />
          <circle cx="12" cy="11.5" r="1.2" fill="currentColor" />
        </svg>
      </div>

      <div class="flex items-center gap-1.5 flex-shrink-0">
        <span class="font-extrabold tracking-tight text-white text-sm sm:text-base group-hover:text-slate-200 transition-colors">
          CLEANPHOTO
        </span>
        <span class="text-[10px] font-mono font-medium text-slate-400 bg-white/[0.04] border border-white/[0.08] px-2 py-0.5 rounded tracking-wide">
          x FIXEEHUB
        </span>
      </div>
    </a>

    <!-- Right: Clean Navigation Links -->
    <nav class="flex items-center gap-3 sm:gap-5 text-xs sm:text-sm text-slate-400 font-medium">
      <a href="#drop-zone" class="hover:text-white transition-colors">Scrubber</a>
      <a href="#why-clean" class="hover:text-white transition-colors">Privacy Story</a>
      <a href="#faq" class="hover:text-white transition-colors">FAQ</a>
    </nav>
  </div>
</header>
