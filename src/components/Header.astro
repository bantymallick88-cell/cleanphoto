---
// Header.astro - Apple / Vercel Standard Minimalist Header
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-[#090A0F]/80 border-b border-white/[0.08] transition-colors">
  <div class="w-full max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
    <!-- Left: Stylish High-End Gradient Logo & Micro Badge -->
    <a href="/" class="flex items-center gap-2.5 sm:gap-3 flex-shrink-0 group">
      <!-- High-Trust Aperture Shield Icon -->
      <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-gradient-to-b from-rose-500/20 to-red-500/5 border border-rose-500/30 flex items-center justify-center text-rose-400 group-hover:border-rose-500/60 shadow-[0_0_20px_-3px_rgba(244,63,94,0.35)] transition-all">
        <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L4 5v6.5C4 16.5 7.4 20.8 12 22c4.6-1.2 8-5.5 8-10.5V5l-8-3z" />
          <circle cx="12" cy="11.5" r="4" stroke-dasharray="2 1.5" />
          <circle cx="12" cy="11.5" r="1.2" fill="currentColor" />
        </svg>
      </div>

      <!-- Gradient Typography + BY FIXEEHUB Micro Pill -->
      <div class="flex items-center gap-2 flex-shrink-0">
        <span class="text-xl font-black tracking-wider bg-clip-text text-transparent bg-gradient-to-r from-rose-400 to-red-600">
          CLEANPHOTO
        </span>
        <span class="text-[9px] sm:text-[10px] font-mono font-bold text-rose-300/90 bg-rose-950/40 border border-rose-500/20 px-1.5 py-0.5 rounded tracking-wider uppercase">
          BY FIXEEHUB
        </span>
      </div>
    </a>
  </div>
</header>
