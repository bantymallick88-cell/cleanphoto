---
// CleanPhoto - Image EXIF & Privacy Metadata Stripper
// Red Threat & Cyber Privacy Vault Edition for cleanphoto.fixeehub.com
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CleanEngine from '../components/CleanEngine.astro';
import PrivacyStory from '../components/PrivacyStory.astro';
import WhyCleanCard from '../components/WhyCleanCard.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import '../styles/global.css';

// Structured Data: SoftwareApplication Schema
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "CleanPhoto",
  "alternateName": "CleanPhoto Privacy Vault",
  "url": "https://cleanphoto.fixeehub.com",
  "applicationCategory": "SecurityApplication",
  "operatingSystem": "Web, All Modern Browsers (Chrome, Firefox, Safari, Edge)",
  "browserRequirements": "Requires JavaScript and HTML5 Canvas API support",
  "description": "Production-ready zero-server web application to strip hidden GPS location coordinates, phone serial numbers, camera signatures, and sensitive metadata in browser RAM before posting to Reddit, Quora, or Discord.",
  "softwareVersion": "2.4.0",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  },
  "featureList": [
    "100% in-browser memory metadata stripping",
    "Physical GPS coordinates and map pin scrubbing",
    "Hardware serial numbers and camera fingerprint removal",
    "Batch ZIP export using JSZip",
    "Original native image dimensions and sharpness preservation"
  ],
  "publisher": {
    "@type": "Organization",
    "name": "FixeeHub",
    "url": "https://fixeehub.com"
  }
};

// Structured Data: FAQPage Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does CleanPhoto destroy EXIF metadata without a backend server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CleanPhoto operates 100% inside your web browser’s JavaScript engine. It loads your image into an in-memory HTML5 Canvas at full native resolution and re-encodes pure pixel data into a fresh Blob, physically dropping all EXIF APP1, IPTC, XMP, and GPS coordinates."
      }
    },
    {
      "@type": "Question",
      "name": "How can I verify zero bytes are uploaded to remote servers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can test CleanPhoto in complete offline airplane mode after loading, or inspect the DevTools Network Tab (F12) to verify 0 outbound HTTP/WebSocket requests during metadata inspection and stripping."
      }
    },
    {
      "@type": "Question",
      "name": "Will my photo lose dimensions, sharpness, or image quality?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The canvas width and height match the original image natural dimensions pixel-for-pixel with high-precision smoothing enabled, preserving full sharpness, aspect ratio, and color depth."
      }
    },
    {
      "@type": "Question",
      "name": "Why don't Reddit and Quora automatically remove GPS data?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "While some web frontends compress photos, mobile apps, third-party viewers, Discord CDN attachments, and direct cloud links frequently retain raw EXIF data. Scrubbing client-side before upload is the only foolproof privacy protection."
      }
    }
  ]
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Technical SEO Meta Tags -->
    <title>CleanPhoto - Free EXIF & Privacy Metadata Stripper | Zero-Server Red Threat Vault</title>
    <meta name="title" content="CleanPhoto - Free EXIF & Privacy Metadata Stripper | Zero-Server Red Threat Vault" />
    <meta name="description" content="Strip hidden GPS location coordinates, camera serial numbers, and sensitive EXIF metadata from photos in your browser RAM before uploading to Reddit, Quora, or Discord. 100% serverless, zero cloud upload." />
    <meta name="keywords" content="EXIF stripper, remove EXIF data, strip GPS coordinates from photo, privacy metadata remover, client-side EXIF remover, Reddit photo privacy, cleanphoto fixeehub, camera serial stripper, zero server photo cleaner" />
    <link rel="canonical" href="https://cleanphoto.fixeehub.com" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#0c0507" />

    <!-- Open Graph / Facebook / Reddit Preview -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cleanphoto.fixeehub.com" />
    <meta property="og:site_name" content="CleanPhoto by FixeeHub" />
    <meta property="og:title" content="CleanPhoto - Free EXIF & GPS Metadata Stripper (100% Zero-Server)" />
    <meta property="og:description" content="Destroy hidden GPS coordinates, camera serials, and timestamps directly in browser RAM before posting photos online. Zero cloud uploads." />
    <meta property="og:image" content="https://cleanphoto.fixeehub.com/favicon.svg" />

    <!-- Twitter Card / Quora Link Previews -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://cleanphoto.fixeehub.com" />
    <meta property="twitter:title" content="CleanPhoto - Zero-Server EXIF & Privacy Metadata Stripper" />
    <meta property="twitter:description" content="Neutralize hidden GPS coordinates, camera body serials, and timestamps locally in browser RAM." />
    <meta property="twitter:image" content="https://cleanphoto.fixeehub.com/favicon.svg" />

    <!-- Google Fonts for JetBrains Mono & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Schema.org JSON-LD Structured Data: SoftwareApplication & FAQPage -->
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body class="bg-[#030102] text-slate-100 min-h-screen selection:bg-red-600/40 selection:text-white antialiased font-sans">
    
    <!-- Fixed Navigation Header -->
    <Header />

    <!-- Main Content Area -->
    <main class="relative z-10 space-y-2">
      <!-- Hero Section with Serverless Red Vault Guarantee -->
      <Hero />

      <!-- Interactive EXIF Threat Inspection & Stripping Engine -->
      <CleanEngine />

      <!-- Story Card: Why Metadata Removal Matters & Contact Info -->
      <PrivacyStory />

      <!-- Threat Breakdown & Payload Inspection -->
      <WhyCleanCard />

      <!-- Technical FAQ & Proof -->
      <Faq />
    </main>

    <!-- Sleek Red Cyber Footer -->
    <Footer />

    <!-- Compact Mobile Action Bar (for 320px+ phone viewports) -->
    <MobileActionBar />
  </body>
</html>
