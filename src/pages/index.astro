---
// CleanPhoto - Image EXIF & Privacy Metadata Stripper
// Principal Linear / Vercel Design Standard for cleanphoto.fixeehub.com
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CleanEngine from '../components/CleanEngine.astro';
import PrivacyStory from '../components/PrivacyStory.astro';
import WhyCleanCard from '../components/WhyCleanCard.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

// Structured Data: SoftwareApplication Schema
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "CleanPhoto",
  "alternateName": "CleanPhoto by FixeeHub",
  "url": "https://cleanphoto.fixeehub.com",
  "applicationCategory": "SecurityApplication",
  "operatingSystem": "Web, All Modern Browsers",
  "browserRequirements": "Requires JavaScript and HTML5 Canvas API support",
  "description": "Production-ready zero-server web application to strip hidden GPS location coordinates, phone serial numbers, camera signatures, and sensitive metadata in browser RAM before posting online.",
  "softwareVersion": "1.2.0",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  },
  "featureList": [
    "100% in-browser memory metadata stripping",
    "Physical GPS coordinates and map pin scrubbing",
    "Hardware serial numbers and camera fingerprint removal",
    "Batch ZIP export using JSZip",
    "Original native image dimensions and sharpness preservation"
  ],
  "publisher": {
    "@type": "Organization",
    "name": "FixeeHub",
    "url": "https://fixeehub.com"
  }
};

// Structured Data: FAQPage Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does CleanPhoto destroy EXIF metadata without a server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CleanPhoto operates 100% inside your web browser’s JavaScript engine. It loads your image onto an in-memory HTML5 Canvas at full native resolution and re-encodes pure pixel data into a fresh Blob, physically dropping all EXIF APP1, IPTC, XMP, and GPS coordinates."
      }
    },
    {
      "@type": "Question",
      "name": "How can I independently verify zero network traffic?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can test CleanPhoto in complete offline airplane mode after loading, or inspect the DevTools Network Tab (F12) to verify 0 outbound HTTP/WebSocket requests during metadata inspection and stripping."
      }
    },
    {
      "@type": "Question",
      "name": "Will my photo lose dimensions, sharpness, or image quality?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The canvas width and height match the original image natural dimensions pixel-for-pixel with high-precision smoothing enabled, preserving full sharpness, aspect ratio, and color depth."
      }
    },
    {
      "@type": "Question",
      "name": "Which image formats are supported?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CleanPhoto supports all modern web image formats: JPEG / JPG, PNG, and WebP. You can choose to preserve the original format or cross-convert during export."
      }
    }
  ]
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Technical SEO Meta Tags -->
    <title>CleanPhoto — Free EXIF & Privacy Metadata Stripper | 100% In-Browser RAM</title>
    <meta name="title" content="CleanPhoto — Free EXIF & Privacy Metadata Stripper | 100% In-Browser RAM" />
    <meta name="description" content="Strip hidden GPS location coordinates, camera serial numbers, and sensitive EXIF metadata from photos in your browser RAM before uploading online. 100% serverless, zero cloud upload." />
    <meta name="keywords" content="EXIF stripper, remove EXIF data, strip GPS coordinates from photo, privacy metadata remover, client-side EXIF remover, Reddit photo privacy, cleanphoto fixeehub, camera serial stripper, zero server photo cleaner" />
    <link rel="canonical" href="https://cleanphoto.fixeehub.com" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#070709" />

    <!-- Open Graph / Social Previews -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cleanphoto.fixeehub.com" />
    <meta property="og:site_name" content="CleanPhoto by FixeeHub" />
    <meta property="og:title" content="CleanPhoto — Free EXIF & GPS Metadata Stripper" />
    <meta property="og:description" content="Destroy hidden GPS coordinates, camera serials, and timestamps directly in browser RAM before posting photos online. Zero cloud uploads." />
    <meta property="og:image" content="https://cleanphoto.fixeehub.com/favicon.svg" />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://cleanphoto.fixeehub.com" />
    <meta property="twitter:title" content="CleanPhoto — Zero-Server EXIF & Privacy Metadata Stripper" />
    <meta property="twitter:description" content="Neutralize hidden GPS coordinates, camera body serials, and timestamps locally in browser RAM." />
    <meta property="twitter:image" content="https://cleanphoto.fixeehub.com/favicon.svg" />

    <!-- Google Fonts for Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Schema.org JSON-LD Structured Data: SoftwareApplication & FAQPage -->
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body class="bg-[#070709] text-slate-100 min-h-screen selection:bg-rose-500/20 selection:text-white antialiased font-sans relative">
    
    <!-- Top Ambient Glow Gradient -->
    <div class="pointer-events-none fixed inset-0 top-ambient-glow z-0"></div>

    <div class="relative z-10 flex flex-col min-h-screen">
      <!-- Floating Glassmorphic Header -->
      <Header />

      <!-- Main Content -->
      <main class="flex-1">
        <!-- Hero Section with Top Pill & Bento Feature Grid -->
        <Hero />

        <!-- Floating Scrubber Dropzone Card -->
        <CleanEngine />

        <!-- Aesthetic Privacy Story Card -->
        <PrivacyStory />

        <!-- Memory Buffer Payload Inspection -->
        <WhyCleanCard />

        <!-- Clean Border-Bottom Accordion FAQs -->
        <Faq />
      </main>

      <!-- Developer Signature & Operational Status Footer -->
      <Footer />
    </div>
  </body>
</html>
